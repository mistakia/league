# OSX
#
.DS_Store

# node.js
#
# No trailing slash: the documented throwaway-worktree deploy recipe symlinks
# node_modules rather than reinstalling it, and `node_modules/` matches only a
# real directory -- so the symlink showed up as untracked and preflight:deploy
# refused its own recipe as a dirty tree.
node_modules
npm-debug.log
yarn-error.log

# Yarn
#
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# App specific
#
# Legacy JS config files (migrated to config/ directory)
config.*.js
# config/*.json files ARE tracked, and only config-production.json is encrypted
# (sops/age, recipients in .sops.yaml). config-development.json and
# config-test.json are committed PLAINTEXT to a PUBLIC repo, so every value in
# them is published: they must hold placeholders only, never a real credential
# and never a value shared with production. The former note here said tracking
# was safe because "encrypted values are safe to commit"; that rationale died
# with the symmetric scheme on 2026-07-15 and its survival is how a live
# production jwt secret sat in config-test.json on GitHub from then until
# 2026-08-27.
key.pem
cert.pem
drive-credentials.json
drive-token.json
*.tar.qz
*.tar.gz
tmp/*
dist/

# Deployment
current
source
.deploys
tmp
# `deploy:sourcemaps` mkdir -p's this on the host and rsyncs *.js.map into it, so
# every deploy manufactured an untracked path in the production checkout that
# `git pull` could collide with -- the same class of failure that aborted the
# 2026-08-25 deploy. `dist/` was ignored and its sourcemap sibling was not.
sourcemaps/

# Cached git worktree used by scripts/data-view-regression-check.mjs
.cache/

# Working-tier artifacts (scratch tier lives outside version control)
scratch/
