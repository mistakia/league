// The commissioner's working surface for the admission vote. Same measure,
// fonts and form language as the manager-facing page and the waiting-list
// questionnaire, because it is the same subject and switching between them
// should not feel like switching applications.
//
// The shared language lives in app/styles/prose-form.styl. Note especially that
// the team checkboxes below draw their own box through prose_checkbox() — the
// global `input { -webkit-appearance: none }` in normalize.css means a bare one
// renders 0x0 and invisible, which is exactly how this page shipped.

.admission-vote-commissioner
  prose_page()

.admission-vote-commissioner__title
  prose_title()

.admission-vote-commissioner__intro
  margin 0 0 2em

.admission-vote-commissioner__section
  margin-top 48px

  h2
    prose_section_title()

// Tighter than the questionnaire's 48px: there the form follows several
// paragraphs of prose, here it follows a section heading that has already
// spaced it.
.admission-vote-commissioner__form
  prose_form()
  margin-top 24px

.admission-vote-commissioner__field
  prose_field()
  border none
  margin 0
  padding 0

  > span
    prose_label()

  // A legend groups several controls, so it is set as a section label rather
  // than as a field label — otherwise it is indistinguishable from the label of
  // the first control inside it, and the two read as two stacked prompts.
  //
  // A legend is also laid out specially inside a fieldset and does NOT take the
  // flex gap above it, so its separation has to be stated.
  > legend
    prose_section_title()
    padding 0
    margin-bottom 12px

  input[type='text'], input[type='number'], input[type='datetime-local']
    prose_input()

  select
    prose_select()

.admission-vote-commissioner__hint
  prose_help()
  margin 0

// The eligibility snapshot and the sponsor lists are both "which teams", so
// they get one control shape rather than two that have to be learned apart.
.admission-vote-commissioner__teams
  display flex
  flex-wrap wrap
  gap 8px 20px
  margin-top 4px

  label
    prose_checkbox_label()

  input[type='checkbox']
    prose_checkbox(16px, 11px)

// One candidate per block. Space separates a block from the legend above it;
// a rule separates one candidate from the NEXT, because several of these stack
// and three unruled blocks of the same shape read as one long form.
.admission-vote-commissioner__candidate
  display flex
  flex-direction column
  gap 12px

  & + &
    margin-top 24px
    padding-top 24px
    border-top 1px solid $borderColor

.admission-vote-commissioner__action
  prose_submit()

.admission-vote-commissioner__action--add
  prose_button_secondary()

.admission-vote-commissioner__totals
  width 100%
  margin-bottom 1.5em
  border-collapse collapse

  th, td
    padding 8px 4px
    text-align left
    border-bottom 1px solid $borderColor

  th
    font-family $prose_mono
    font-size 0.8125em
    font-weight 700
    letter-spacing 0.08em
    text-transform uppercase
    color $textColor

  td
    color $textColorDark

.admission-vote-commissioner__notice
  prose_message()

.admission-vote-commissioner__error
  prose_error()
