// Wider than the restricted-free-agency card: an expanded row carries two
// perspectives side by side, and each chain row is a five-column line.
.league-container.trade-review-container
  max-width 1200px
  padding 16px 16px 24px

.trade-review__back
  align-items center
  background transparent
  border none
  color #1565c0
  cursor pointer
  display flex
  font-size 13px
  gap 2px
  margin-bottom 12px
  padding 0
  text-align left

  svg
    font-size 18px

  &:hover
    text-decoration underline

.trade-review__empty
  color #757575
  padding 32px 0
  text-align center

@media (max-width 599px)
  .league-container.trade-review-container
    padding 12px 8px 24px
