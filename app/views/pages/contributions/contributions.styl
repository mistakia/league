.contributions
  margin-top 64px
  max-width 720px

  &__title
    font-size 22px
    font-weight 600
    margin 0 0 12px

  &__breadcrumb
    margin-bottom 12px
    font-size 13px

  &__meta
    display flex
    flex-wrap wrap
    align-items center
    gap 12px
    font-size 13px
    color rgba(0, 0, 0, 0.6)
    margin-bottom 16px

  &__body
    white-space pre-wrap
    line-height 1.5
    margin 16px 0

  &__empty
    display flex
    flex-direction column
    align-items flex-start
    gap 12px

  &__list
    display flex
    flex-direction column

  &__row
    display flex
    flex-direction column
    gap 6px
    padding 12px 0
    border-bottom 1px solid rgba(0, 0, 0, 0.12)
    text-decoration none
    color inherit

    &:hover
      background rgba(0, 0, 0, 0.02)

  &__row-title
    font-weight 500

  &__row-meta
    display flex
    align-items center
    gap 10px
    font-size 12px
    color rgba(0, 0, 0, 0.6)

  &__questions
    margin-top 24px

  &__question
    padding 12px 0
    border-top 1px solid rgba(0, 0, 0, 0.12)

  &__question-text
    font-weight 500
    margin-bottom 8px

  &__answer
    white-space pre-wrap
    padding-left 12px
    border-left 2px solid rgba(0, 0, 0, 0.12)
