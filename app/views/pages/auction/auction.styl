.auction
  absolute left 0 top 0 right 0 bottom 0
  display flex
  flex-direction column

.auction__menu
  display flex
  height 100%
  flex-direction row

  .base-TabPanel-root
    height 100%
    position relative

  .base-TabsList-root
    flex 0 0 auto

.auction__main-board
  display flex
  height 100%
  flex-direction column
  flex 1
  overflow hidden
  overflow-y scroll
  background white

@media (max-width 800px)
  .auction__main
    margin 0

// The election-mode side rail. In election mode the PAGE is the auction: the
// live bid bar is app-level chrome that mounts for blocks, so what a manager
// needs between blocks lives here.
.auction__side
  flex 0 0 320px
  display flex
  flex-direction column
  overflow-y auto
  border-left 1px solid rgba(0, 0, 0, 0.12)

@media (max-width 800px)
  .auction__menu
    flex-direction column

  .auction__side
    flex 0 0 auto
    border-left none
    // ROOM FOR THE FLOATING MENU BUTTON, which is `position fixed` and is
    // therefore not part of any layout that could make room for it on its own.
    // Below 799px it sits at `bottom $auctionHeightMobile + 8px` -- just clear
    // of the auction chrome -- and the page reserves exactly
    // $auctionHeightMobile for that chrome, so the button lands squarely on
    // whatever this rail ends with. Measured at 768 it covered 9% of the
    // standing elections row and 11% at 600, taking the `open spots` count with
    // it.
    //
    // A floating button over CONTENT is normal and is what it does on every
    // other page. What makes it a defect here is that this rail does not
    // scroll: the covered row cannot be moved out from under the button, so the
    // count is simply never readable. The clearance is the button's own
    // footprint above the chrome -- its 8px offset plus its 46px height -- and
    // 8px again so the row does not sit flush against it.
    padding-bottom 62px
    border-top 1px solid rgba(0, 0, 0, 0.12)
