.auction
  absolute left 0 top 0 right 0 bottom 0
  display flex
  flex-direction column

.auction__menu
  display flex
  height 100%
  flex-direction row

  .base-TabPanel-root
    height 100%
    position relative

  .base-TabsList-root
    flex 0 0 auto

.auction__main-board
  display flex
  height 100%
  flex-direction column
  flex 1
  overflow hidden
  overflow-y scroll
  background white

@media (max-width 800px)
  .auction__main
    margin 0

// The election-mode side rail. In election mode the PAGE is the auction: the
// live bid bar is app-level chrome that mounts for blocks, so what a manager
// needs between blocks lives here.
.auction__side
  flex 0 0 320px
  display flex
  flex-direction column
  overflow-y auto
  border-left 1px solid rgba(0, 0, 0, 0.12)

@media (max-width 800px)
  .auction__menu
    flex-direction column

  // NO BOTTOM PADDING FOR THE FLOATING MENU BUTTON. Reserving a strip of this
  // rail for a `position fixed` control means the rail gives up height it does
  // have to a control that is not in its layout -- and on a phone that height
  // is the scarcest thing on the screen. The button moves up out of the way
  // instead; the offset is in menu.styl, which is where its position already
  // lives.
  .auction__side
    flex 0 0 auto
    border-left none
    border-top 1px solid rgba(0, 0, 0, 0.12)
