// FLAT, NOT RAISED. This carried MUI's three-layer elevation shadow — the
// stacked rgba(0,0,0,.2)/.14/.12 triple that paints a card as a sheet of paper
// lifted off the page — plus a 6px 6px 0 0 radius that rounded only its top
// corners, so two sections in a column met at a seam that read as one torn
// card rather than as two.
//
// A section is now a plain white field separated by a hairline rule, which is
// how the rest of this surface's controls are drawn. Nothing here sits on a
// z-axis: the boundary is the border, and there is no shadow at any depth.
.setting-section
  background $prose_paper
  border 1px solid $prose_rule
  border-radius 3px
  padding 20px

  + .setting-section
    margin-top 16px

  // THE FIELD CAP IS HERE, NOT IN THE `grid` PROP. EditableSettingField takes
  // MUI Grid breakpoints, and a breakpoint is a FRACTION of the container: the
  // `xs: 8` those two fields carry resolved to two-thirds of a 1200px page, so
  // a 20-character username sat in a ~770px box. Widening the browser made it
  // worse, which is the tell that the wrong axis was being specified.
  //
  // Capping the item rather than changing the fraction keeps the field at
  // $field_width on a wide page and lets it collapse with the container on a
  // narrow one. Two classes deep, so it beats MUI's own single-class
  // `.MuiGrid-grid-xs-8` without !important.
  .MuiGrid-item
    max-width $field_width

  h2
    // The gap is the heading's, not the first control's. The Account section
    // opens straight onto its inputs with nothing between them, so a 4px margin
    // put the label of the first field against the section title.
    margin 0 0 16px
    font-family $prose_mono
    font-weight $prose_bold
    font-size 13px
    letter-spacing 0.14em
    text-transform uppercase
    color $prose_muted
