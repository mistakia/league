// A judgement about people, read at a prose measure rather than in the app's
// dense table chrome — the same reasoning and the same two fonts as the
// waitlist applications page it links out to.
$admission_vote_sans = 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif
$admission_vote_mono = 'IBM Plex Mono', monospace

.admission-vote
  max-width 720px
  margin 0 auto 80px
  padding 24px 16px
  font 400 16px/1.65 $admission_vote_sans
  color $textColor

  a
    color $textColorDark
    border-bottom 1px solid $borderColor
    &:hover
      border-bottom 1px solid $accentColor

  h2
    margin 0 0 0.5em
    font-family $admission_vote_mono
    font-size 1.125em
    color $textColorDark

.admission-vote__title
  margin 0 0 0.5em
  font-family $admission_vote_mono
  font-size 1.5em
  line-height 1.25
  color $textColorDark

.admission-vote__intro
  margin 0 0 2em

.admission-vote__section
  padding-top 32px
  margin-top 40px
  border-top 1px solid $borderColor

.admission-vote__meta
  font-size 0.875em
  color $textColor

// A rule between candidates rather than a box around each: the panels are
// short, and a border the eye has to keep checking reads as a container.
.admission-vote__candidate
  margin-top 20px
  padding-top 20px
  border-top 1px solid $borderColor

.admission-vote__candidate-name
  margin 0 0 0.25em
  font-family $admission_vote_mono
  font-size 1.125em
  color $textColorDark

.admission-vote__candidate-meta
  font-size 0.875em
  color $textColor

.admission-vote__ballot-intro
  margin 0 0 1.5em

// One row per preference, numbered, because the RANK is the thing being
// entered and a bare list of selects does not say which one is first.
.admission-vote__slot
  display flex
  align-items center
  gap 12px
  margin-bottom 12px

  select
    flex 1
    padding 6px 8px
    font 400 15px $admission_vote_sans
    color $textColorDark

.admission-vote__slot-label
  flex 0 0 110px
  font-family $admission_vote_mono
  font-size 0.8125em
  color $textColor

.admission-vote__ballot
  button
    margin-top 12px
    padding 8px 16px
    font-family $admission_vote_mono
    font-size 0.875em
    cursor pointer

    &:disabled
      cursor not-allowed
      opacity 0.5

// Points per candidate and nothing else. Section 10(e) discloses this figure
// for each Candidate; a per-team row is the thing it forbids, so there is
// deliberately no markup here that one could be rendered into.
.admission-vote__totals
  width 100%
  margin-bottom 1.5em
  border-collapse collapse

  th, td
    padding 8px 4px
    text-align left
    border-bottom 1px solid $borderColor

  th
    font-family $admission_vote_mono
    font-size 0.8125em
    font-weight 700
    color $textColor

  td
    color $textColorDark

.admission-vote__decision
  margin 0 0 1em
  color $textColorDark

.admission-vote__notice
  padding 12px 14px
  border-left 3px solid $borderColor
  color $textColorDark

.admission-vote__error
  padding 12px 14px
  border-left 3px solid $accentColor
  color $textColorDark
