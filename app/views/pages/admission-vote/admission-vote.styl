// A judgement about people, read at a prose measure rather than in the app's
// dense table chrome — the same measure, fonts and form language as the
// waiting-list questionnaire, which is where these candidates came from and
// which several of these readers filled in themselves.
//
// The shared language lives in app/styles/prose-form.styl.

.admission-vote
  prose_page()

.admission-vote__title
  prose_title()

.admission-vote__intro
  margin 0 0 2em

// Spacing sets the sections apart rather than a rule, which is how the
// questionnaire does it — a page about a person should not read as paperwork.
.admission-vote__section
  margin-top 48px

  h2
    prose_section_title()

.admission-vote__meta
  prose_help()

// A rule between candidates rather than a box around each: the panels are
// short, and a border the eye has to keep checking reads as a container. This
// is a list separator rather than form chrome, which is why it survives on a
// page that otherwise has no rules.
.admission-vote__candidate
  margin-top 20px
  padding-top 20px
  border-top 1px solid $borderColor

.admission-vote__candidate-name
  margin 0 0 0.25em
  font-family $prose_mono
  font-weight 700
  font-size 1.0625em
  color $textColorDark

.admission-vote__candidate-meta
  prose_help()

.admission-vote__ballot-intro
  margin 0 0 0.5em

.admission-vote__ballot
  prose_form()
  margin-top 24px

  button[type='submit']
    prose_submit()

// One block per preference, numbered, because the RANK is the thing being
// entered and a bare list of selects does not say which one is first. Same
// shape as a questionnaire field: label above the control, not beside it.
.admission-vote__slot
  prose_field()

  select
    prose_select()

// The ordinal, its point value and the optional marker read left to right on
// one line, so `prose_label()` is given a flex row rather than being wrapped in
// one — the mixin sets the type and nothing about layout.
.admission-vote__slot-label
  prose_label()
  display flex
  align-items baseline
  gap 8px

// Set apart from the ordinal rather than beside it in the same weight: this is
// the number a manager is choosing BETWEEN slots on, so it has to be findable
// while scanning down the column, and it is not part of the label's sentence.
.admission-vote__slot-points
  font-weight 400
  color $textColor

// Quieter still than the points. It says a slot may be skipped, which is worth
// stating on every one of them and worth nobody reading twice.
.admission-vote__slot-optional
  font-weight 400
  font-style italic
  color lighten($textColor, 20)

// Points per candidate and nothing else. Section 10(e) discloses this figure
// for each Candidate; a per-team row is the thing it forbids, so there is
// deliberately no markup here that one could be rendered into.
.admission-vote__totals
  width 100%
  margin-bottom 1.5em
  border-collapse collapse

  th, td
    padding 8px 4px
    text-align left
    border-bottom 1px solid $borderColor

  th
    font-family $prose_mono
    font-size 0.8125em
    font-weight 700
    letter-spacing 0.08em
    text-transform uppercase
    color $textColor

  td
    color $textColorDark

.admission-vote__decision
  margin 0 0 1em
  color $textColorDark

.admission-vote__notice
  prose_message()

.admission-vote__error
  prose_error()
