// The questionnaire is read by the same person who just read the landing page,
// so it carries the same measure and the same two fonts. Anything that looks
// like the app's dense chrome would read as a different site.
$waitlist_sans = 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif
$waitlist_mono = 'IBM Plex Mono', monospace

.waitlist
  max-width 660px
  margin 0 auto 80px
  padding 24px 16px
  font 400 17px/1.7 $waitlist_sans
  color $textColor

  p
    margin 0 0 1em

  a
    color $textColorDark
    font-weight 700
    font-family $waitlist_mono
    border-bottom 1px solid $borderColor
    &:hover
      border-bottom 1px solid $accentColor

.waitlist__title
  margin 0 0 0.75em
  font-family $waitlist_mono
  font-size 1.5em
  line-height 1.25
  color $textColorDark

.waitlist__form
  display flex
  flex-direction column
  gap 32px
  margin-top 48px

// Each question is a block: prompt, then the reason it is being asked, then the
// box. The gap above carries the separation, so there are no rules or boxes
// around a question — a form that looks like paperwork gets abandoned.
.waitlist__field
  display flex
  flex-direction column
  gap 8px

.waitlist__label
  font-family $waitlist_mono
  font-weight 700
  font-size 0.9375em
  line-height 1.4
  color $textColorDark

.waitlist__optional
  font-weight 400
  color $textColor

.waitlist__help
  font-size 0.875em
  line-height 1.5
  color $textColor

.waitlist__input
  width 100%
  padding 10px 12px
  font 400 17px/1.5 $waitlist_sans
  color $textColorDark
  background transparent
  border 1px solid $borderColor
  border-radius 2px
  box-sizing border-box
  &:focus
    outline none
    border-color $accentColor

.waitlist__input--multiline
  resize vertical

// Off screen rather than `display: none` or `visibility: hidden`, both of which
// a bot can cheaply detect and skip. `tabIndex={-1}` and `autoComplete='off'` at
// the call site keep it away from keyboard users and password managers.
.waitlist__honeypot
  position absolute
  left -9999px
  width 1px
  height 1px
  opacity 0

.waitlist__error
  padding 12px 14px
  font-size 0.9375em
  color $textColorDark
  border-left 3px solid $accentColor

.waitlist__submit
  align-self flex-start
  padding 14px 24px
  font-family $waitlist_mono
  font-weight 700
  font-size 0.9375em
  letter-spacing 0.02em
  color white
  background $textColorDark
  border none
  border-radius 2px
  cursor pointer
  transition background 120ms ease
  &:hover
    background $accentColor
  &:focus-visible
    outline 2px solid $accentColor
    outline-offset 3px
  &:disabled
    opacity 0.5
    cursor default
