// The landing page is read by people with no account and no context, so it is
// a single readable column of prose rather than the dense app chrome the rest
// of the site uses. Fonts follow the markdown pages: mono for headings, sans
// for body copy.
$landing_sans = 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif
$landing_mono = 'IBM Plex Mono', monospace

// 660px at 17px holds the copy near 70 characters a line. Wider than this and
// the eye loses the start of the next line on the long paragraphs.
.landing
  max-width 660px
  margin 0 auto 80px
  padding 24px 16px
  font 400 17px/1.7 $landing_sans
  color $textColor

  h2
  h3
    font-family $landing_mono
    color $textColorDark
    line-height 1.25

  p
    margin 0 0 1em
    font-family inherit
    line-height inherit
    letter-spacing normal

  // Links carry the body ink with a standing underline. Accent red is spent on
  // the call to action alone, so nothing competes with it for the eye.
  a
    color $textColorDark
    font-weight 700
    font-family $landing_mono
    border-bottom 1px solid $borderColor
    &:hover
      border-bottom 1px solid $accentColor

.landing__hero
  padding-bottom 32px
  border-bottom 1px solid $borderColor

// Mono ties the opening sentence to the section headings below it, so the page
// starts on something that reads as a beginning rather than as body copy.
// Qualified with the element so it wins over the `.landing p` reset above,
// which would otherwise take back the family and the line height.
.landing p.landing__lede
  margin 0
  font-family $landing_mono
  font-size 1.25em
  line-height 1.4
  color $textColorDark

.landing__hero-actions
  display flex
  flex-wrap wrap
  align-items center
  gap 16px
  margin-top 28px

// The single call to action, and the one obvious next step on a page that is
// otherwise all prose and links. Qualified with the page class so it wins over
// the generic `.landing a` rules above.
.landing a.landing__cta
  display inline-block
  padding 14px 24px
  background $textColorDark
  color white
  font-family $landing_mono
  font-weight 700
  font-size 0.9375em
  letter-spacing 0.02em
  border-radius 2px
  border-bottom none
  transition background 120ms ease
  &:hover
    background $accentColor
    border-bottom none
  &:focus-visible
    outline 2px solid $accentColor
    outline-offset 3px

// The proof link beside the primary action. Same size and weight so the pair
// reads as one row, ink instead of fill so only one of them asks to be clicked.
.landing a.landing__cta--secondary
  background transparent
  color $textColorDark
  box-shadow inset 0 0 0 1px $borderColor
  &:hover
    background transparent
    color $accentColor
    box-shadow inset 0 0 0 1px $accentColor

// Spacing carries the hierarchy on a page with no rules or boxes: sections are
// far apart, items within one are closer, lines within an item closer still.
.landing__section
  margin-top 60px

.landing__section-title
  margin 0 0 0.75em
  font-size 1.375em

.landing__group
  margin-bottom 28px

.landing__group-title
  margin 0 0 0.5em
  font-size 0.8125em
  letter-spacing 0.08em
  text-transform uppercase
  color $textColor

.landing__list
  margin 0
  padding-left 1.25em

  li
    margin-bottom 0.7em

.landing__trust-item
  margin-bottom 40px

  h3
    margin 0 0 0.5em
    font-size 1.1875em

  p
    margin-bottom 0.5em
