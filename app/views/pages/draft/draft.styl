.draft
  absolute left 0 top 0 right 0 bottom 0
  display flex
  flex-direction column

.draft__selected
  flex 0 0 auto
  background lighten($backgroundColor, 90%)
  display flex
  max-height 150px
  margin 4px 16px 8px
  border-radius 10px

.draft__selected-head
  flex 0 0 auto

.draft__selected-action
  display flex
  padding 0 16px 16px

.draft__selected-title
  font-size 2em
  font-weight 500
  padding 16px

.draft__selected-alt
  padding 0 16px 16px
  display flex
  align-items center
  div
    display inline-block
    + div
      margin-left 8px

.draft__selected-body
  flex 1
  overflow hidden
  overflow-y scroll
  display flex
  flex-wrap wrap
  div
    flex 1
    padding 16px
    font-weight 900
  label
    font-size 10px
    font-weight 500
    display block
    color lighten($textColor, 30)

.draft__main
  flex 4
  border-left 1px solid $borderColor
  border-right 1px solid $borderColor
  display flex
  flex-direction column

.draft__main-filter
  flex 0 0 auto
  padding 0 16px 8px

.draft__main-board
  flex 1
  border-bottom 1px solid $borderColor
  display flex
  height 100%
  min-height 0

.draft__main-board-pos
  flex 1
  display flex
  flex-direction column
  + .draft__main-board-pos
    border-left 1px solid $borderColor

.draft__main-board-pos-head
  flex 0 0 auto
  display flex
  justify-content center
  align-items center
  padding 8px
  border-bottom 1px solid $borderColor

.draft__main-board-pos-count
  margin-left 6px
  padding 0 6px
  border-radius 8px
  font-size 10px
  font-weight 600
  background $backgroundColor
  color lighten($textColor, 25)

.draft__main-board-pos-body
  flex-grow 1
  min-height 0

.draft__main-board-pos-empty
  padding 16px
  text-align center
  font-size 12px
  color lighten($textColor, 35)

.draft__side
  flex 0 0 auto
  height 140px
  display flex
  flex-direction column
  width 100%

.draft__side-top
  flex 0 0 auto

.draft__side-top-pick
  padding 4px 16px 8px
  font-size 11px
  margin 0 auto

.draft__side-top-pick-title
  font-size 12px
  padding-bottom 4px

.draft__side-main
  flex 9
  padding 8px 16px 16px
  overflow hidden
  overflow-x scroll
  display flex
  flex-direction row

@media (max-width 1000px)
  .draft__main-board-pos:not(.overall)
    display none

@media (max-width 700px)
  // The head and body sit side by side on a wide screen, which on a phone
  // squeezes the fifteen combine cells into unreadable slivers and pushes the
  // Draft button off the visible area of a 150px-tall panel.
  .draft__selected
    flex-direction column
    max-height 50vh
    margin 4px 8px 8px

  .draft__selected-head
    display flex
    flex-wrap wrap
    align-items center
    padding 12px 12px 0

  .draft__selected-title
    flex 1 1 100%
    font-size 1.3em
    padding 0 0 4px

  .draft__selected-alt
    flex 1 1 auto
    padding 0 0 12px

  // Full width and last in the head, so the primary action of the page is
  // always the thing directly under the player's name rather than a target
  // competing with the position and team chips.
  .draft__selected-action
    flex 1 1 100%
    padding 0 0 12px
    .button
      width 100%
      height 44px

  .draft__selected-body
    div
      flex 1 0 33%
      padding 8px 12px

  .draft__main-filter
    padding 0 8px 8px

  .draft__main-board
    border-bottom none

  .draft__side
    height 110px

  .draft__side-main
    padding 8px
