.players__head
  flex 1
  display flex
  flex-direction column
  width 100%

.players__head-expand
  margin-bottom 4px
  +button_override()
    flex 1 1 100%
    display flex
    height 20px

  .icon
    border-radius 99em

  &:hover .icon
    background white

.players__filters
  flex 0 0 auto
  display flex
  flex-direction column
  width 100%

  // The chevron's turn is `flipped={expanded}` on the Icon now (players.js),
  // shared with every other disclosure rather than redrawn as a rotate here.

.players__filters-row
  flex 0 0 auto
  border-bottom 1px solid $borderColor
  padding 4px 32px
  display flex
  gap 8px
  align-items center
  flex-wrap wrap

.players__header
  position sticky
  top 0
  flex 1
  z-index 2
  background $backgroundColor
  width max-content
  min-width 100%
  height 48px
  display flex
  align-items stretch
  font-weight 500
  border-bottom 1px solid $borderColor

.players__header
  .row__group-head
    overflow hidden
    text-overflow ellipsis
    position absolute
    top 0
    left 0
    right 0
  .row__group-body
    align-items flex-end

// players__table container styles provided by .page-table__container in app/styles/table.styl

@media (max-width 600px)
  .players__head
    margin-top 8px

  .players__view-export
    +button_override()
      display none

  .players__filters-row
    padding 4px

  .search__filter
    flex 1
    flex-basis 100%