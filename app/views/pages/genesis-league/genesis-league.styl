// The Genesis League pitch page is read by people with no account and no context, so it is
// a single readable column of prose rather than the dense app chrome the rest
// of the site uses. It shares its page language — measure, paper, type scale,
// buttons — with the questionnaire it hands the reader to, because the two are
// read one after another and a change of measure between them reads as a
// change of site. That language lives in app/styles/prose-form.styl.

.genesis-league-surface
  prose_surface()

.genesis-league
  prose_page_wide()

  h2
  h3
    font-family $prose_mono
    font-weight $prose_bold
    color $prose_ink
    line-height 1.25
    letter-spacing -0.01em

  p
    margin 0 0 1em
    font-family inherit
    line-height inherit
    letter-spacing normal

// Qualified with the element, like the lede and the deck below: the `.genesis-league
// p` reset above is (0,1,1) and silently wins over a bare class, which is what
// had the eyebrow rendering in the body face instead of the mono.
.genesis-league p.genesis-league__eyebrow
  prose_eyebrow()

// No rule of its own. The first section's band rule is the masthead rule — see
// prose_section_band().
.genesis-league__hero
  padding-bottom 0

// The opening sentence is the page's headline, not its first paragraph: set at
// display size in the mono that is this site's signature, at a measure short
// enough to be taken in rather than read. Mono sets loose and even, so at this
// size it needs negative tracking and tight leading — without them it reads as
// a terminal dump, which is the failure mode of every mono headline.
// Balanced and pretty here for the same reason the landing page's are: a
// headline never leaves one word alone on its second line, and prose never
// leaves an orphan. Both degrade to `normal` where unsupported, so they are
// polish that cannot break a layout. The two pages are read one after another
// and had this on only one of them.
.genesis-league h1.genesis-league__lede
  margin 0
  max-width 26ch
  text-wrap balance
  font-family $prose_mono
  font-weight $prose_bold
  font-size clamp(25px, 3.1vw, 34px)
  line-height 1.3
  letter-spacing -0.025em
  color $prose_ink

  @media (max-width 640px)
    max-width none

// The qualifying facts, in the body face so they read as the explanation of
// the headline rather than as a second headline.
.genesis-league p.genesis-league__deck
  margin 26px 0 0
  max-width 46ch
  font-size 1.125em
  line-height 1.55
  letter-spacing normal
  color $prose_body
  text-wrap pretty

  @media (max-width 640px)
    margin-top 20px
    font-size 1.0625em

// The two next steps, set as links rather than buttons: the waitlist and the
// live league. Mono at label size, matching the group labels further down, so
// the page reads as one typographic system rather than a pitch with controls.
.genesis-league p.genesis-league__hero-links
  display flex
  flex-wrap wrap
  gap 28px
  margin 32px 0 0
  font-family $prose_mono
  font-weight $prose_bold
  font-size 0.9375em
  letter-spacing -0.01em

// A rule opens each section and the spacing inside it carries the rest: items
// within a group are closer than the groups are to each other, and the groups
// closer than the sections.
.genesis-league__section
  prose_section_band()
  margin-top 64px

  &:first-of-type
    prose_section_band(2px)

  @media (max-width 640px)
    margin-top 48px

// The section is the parent of the groups inside it, and what separates them is
// the FACE: the section head is sans under a band rule, a group label is mono
// and grey in the rail. Sizing the parent larger was the old answer and it cost
// a fourth step in the type scale to say something the two faces already say.
// Qualified with the element for the same reason the eyebrow is: the
// `.genesis-league h2, h3` block above is (0,1,1) and beats a bare class on
// family, weight and tracking while letting font-size through, which renders as
// a half-applied label.
.genesis-league h2.genesis-league__section-title
  prose_section_label()
  margin-bottom 40px

  @media (max-width 640px)
    margin-bottom 32px

// Each group is a rail row: its label in the left column, its prose beside it.
// A hairline above each one separates them without drawing a box around
// anything, which is the same treatment the landing page's directory entries
// take — the two pages are read one after another, and a group of league rules
// and a directory entry are the same object. The first group takes none, so the
// rule never doubles up under the band above it.
.genesis-league__group
  prose_rail()
  padding-top 24px
  margin-top 24px
  border-top 1px solid $prose_rule

  &:first-of-type
    padding-top 0
    margin-top 0
    border-top none

// QUALIFIED WITH THE ELEMENT. The `.genesis-league h2, h3` block above is
// (0,1,1) and silently beat this class on colour, tracking and line-height
// while letting font-size and text-transform through — so the label rendered
// uppercase at the right size in near-black at -0.01em, which is the section
// head's own voice rather than the muted rail label this is meant to be. That
// is the half-applied failure the file's other rules are qualified against.
.genesis-league h3.genesis-league__group-title
  prose_section_title()
  margin 0

  @media (max-width 640px)
    margin-bottom 0.9em

// The prose half of a rail row that is paragraphs rather than a list. Its last
// paragraph carries a link, which needs the gap a paragraph would take rather
// than sitting flush against the text above it.
.genesis-league__group-body
  p
    margin 0 0 1.1em

.genesis-league p.genesis-league__group-link
  margin 0

// NO MARK OF ANY KIND — no disc, and no dash either. The rail already names
// the group these belong to, so a per-item mark states membership a second
// time, and it cost the items a 22px indent that pushed them off the prose
// column every other block on the page aligns to. The gap between items is
// what says they are separate, so it is larger than a paragraph's.
.genesis-league__list
  margin 0
  padding 0
  list-style none

  li
    margin-bottom 1.1em
    text-wrap pretty

    &:last-child
      margin-bottom 0

// The closing rule matches the masthead's rather than a section band's: it
// closes the page the way the first one opened it.
.genesis-league__closing
  display flex
  margin-top 64px
  padding-top 36px
  border-top 2px solid $prose_rule_heavy
  font-family $prose_mono
  font-weight $prose_bold
  font-size 0.9375em
  letter-spacing -0.01em

  @media (max-width 640px)
    margin-top 48px
