// One panel, two resting sizes. Closed it is a single quiet button in the
// controls strip; open it is the widest thing on an empty page, because a
// prompt the user cannot read back is a prompt they cannot correct.
//
// Closed, the element is shrink-to-fit so the controls strip around it -- which
// is itself `width: fit-content` -- stays the width of its own buttons.
.data-view-generation
  display flex
  flex-direction column
  gap 6px
  width fit-content
  max-width 100%
  font 400 13px/1.45 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif

.data-view-generation__open
  align-self flex-start
  display flex
  align-items center
  height 28px
  padding 0 12px
  background white
  border 1px solid $borderColor
  border-radius $button_border_radius
  cursor pointer
  color $textColor
  font inherit
  font-weight 500
  transition border-color 120ms ease, color 120ms ease

  &:hover
    border-color $textColor

  &:focus-visible
    outline 2px solid $accentColor
    outline-offset 2px

// A run that is still going while the panel is hidden. Ink border and weight
// rather than a colour or a spinner: the accent is spent on hover, focus and
// error, and a run in progress is none of the three.
.data-view-generation__open--live
  border-color $textColor
  font-weight 600

.data-view-generation--open
  // Paper, not ground: the panel is a control the user is working inside, and
  // it has to separate from the page it floats over.
  padding 10px 12px 8px
  background white
  border 1px solid $borderColor
  border-radius $button_border_radius

  // ONE DECLARED WIDTH, HELD THROUGH EVERY STATE, and this is the rule the
  // panel is laid out around rather than a preference about size.
  //
  // The controls strip that hosts it is `width: fit-content`, so a panel sized
  // by its contents made the strip -- and the panel with it -- resize on every
  // step of a run: the status row appearing, an instruction line of a different
  // length, a timeline entry with a long tool name, the explanation arriving at
  // the end. The user watches the box breathe while trying to read what is
  // inside it. A declared px width is what stops that, and it has to sit on the
  // OPEN modifier so the closed button is still shrink-to-fit.
  //
  // 880px against the old 640: the panel holds three things that are all
  // measured in characters -- a prompt being proofread before it is sent, an
  // agent timeline whose rows are tool names and arguments, and an explanation
  // paragraph -- and at 640 all three wrapped hard enough to be read as a
  // column rather than as sentences.
  width 880px
  // The one thing allowed to move it, because a panel wider than the window
  // scrolls the page sideways. The strip's own bound is `100vw - 60px`.
  max-width calc(100vw - 80px)

.data-view-generation__form
  display flex
  flex-direction column
  gap 6px

.data-view-generation__input
  // Borderless inside the panel. The panel IS the input's frame -- drawing a
  // second border around the textarea puts two rounded rectangles 12px apart
  // and makes the padding read as a mistake.
  width 100%
  min-height 60px
  // The cap the auto-grow in the component grows into. Past this the prompt is
  // long enough that scrolling it is the lesser cost against a panel that
  // pushes the table off screen.
  max-height 220px
  padding 0
  border 0
  background transparent
  resize none
  overflow-y auto
  color $textColor
  font inherit
  font-size 14px
  line-height 1.5

  &::placeholder
    color rgba(0, 0, 0, 0.36)

  // The panel is opened BY the user and focuses itself, so a ring here would
  // be lit at rest on every open. The buttons below carry their own.
  &:focus
    outline none

  &:disabled
    color rgba(0, 0, 0, 0.5)
    // Deliberately not greyed to a fill: while a run is live this is the only
    // copy of the instruction on screen and it still has to read as text.
    -webkit-text-fill-color rgba(0, 0, 0, 0.5)

// Once a run exists the box is a record of the prompt, and it takes exactly the
// height of that prompt. The floor above is a WRITING affordance -- it tells
// someone facing an empty panel that a sentence or three will fit -- and it has
// no job once the sentence has been sent, where it only pushes the status row
// and the timeline down behind two blank lines.
.data-view-generation__input--compact
  min-height 0

.data-view-generation__actions
  display flex
  align-items center
  justify-content flex-end
  gap 4px
  // Reserved so the row does not jump a button's height when `Build it`
  // appears on the first keystroke.
  min-height 28px

.data-view-generation__hint
  margin-right auto
  color rgba(0, 0, 0, 0.4)
  font-size 11px

.data-view-generation__cancel
.data-view-generation__submit
  height 28px
  border-radius $button_border_radius
  cursor pointer
  font inherit
  font-size 12px
  font-weight 500
  transition background-color 120ms ease, color 120ms ease

  &:focus-visible
    outline 2px solid $accentColor
    outline-offset 2px

.data-view-generation__cancel
  padding 0 8px
  border 0
  background transparent
  color rgba(0, 0, 0, 0.5)

  &:hover
    background rgba(0, 0, 0, 0.05)
    color $textColor

.data-view-generation__submit
  padding 0 14px
  border 0
  background $textColorDark
  color white
  font-weight 600

  &:hover
    background black

.data-view-generation__status
  display flex
  align-items center
  gap 8px
  padding-top 8px
  border-top 1px solid rgba(0, 0, 0, 0.08)
  color mix($textColor, white, 70%)
  font-size 12px

.data-view-generation__status-label
  flex-shrink 0
  font-weight 600
  color $textColor

.data-view-generation__instruction
  // The instruction is arbitrary user text on one line in a constrained row.
  min-width 0
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

.data-view-generation__trajectory
  flex-shrink 0
  margin-left auto
  font-variant-numeric tabular-nums

.data-view-generation__timeline
  // COLLAPSED IS ONE ROW; EXPANDED IS A LIST, and the panel sits in a controls
  // strip that must not grow with it. A fifteen-minute run can hold hundreds of
  // entries, so the expanded region scrolls inside a bounded box rather than
  // pushing the table down the page.
  //
  // The bound is on the CONTENT wrapper rather than on the package's own
  // element: the component is presentational and owns no layout, which is what
  // lets base and league frame it differently.
  min-width 0
  max-height 320px
  overflow-y auto
  margin-top 8px
  padding 6px 8px
  border 1px solid rgba(0, 0, 0, 0.08)
  border-radius $button_border_radius
  background $backgroundColor
  font-size 12px
  // Tool arguments and file paths are the timeline's own vocabulary and none of
  // them break at a space.
  overflow-wrap anywhere

  // Collapsed, the box is a single row and a scrollbar or a fixed height would
  // both be wrong. :has is what lets the frame follow the component's own
  // expansion state without league mirroring it into a second class.
  &:not(:has(.rat-timeline-expanded))
    max-height none
    overflow-y visible

.data-view-generation__timeline-redacted
  // A masked timeline is structurally identical to a real one -- same entries,
  // same types, same counts -- so without a word here a permission failure
  // reads as an ordinary quiet run.
  margin-bottom 4px
  color rgb(95, 33, 32)
  font-size 12px

.data-view-generation__explanation,
.data-view-generation__refusal,
.data-view-generation__error
  margin-top 8px
  padding 8px 10px
  border-radius $button_border_radius
  font-size 12px
  line-height 1.5
  // The panel's width is declared and these three hold arbitrary agent prose,
  // which can carry a column id or a SQL fragment longer than the line. Without
  // this the unbreakable token overflows the fixed box instead of wrapping in
  // it, which is the failure a fixed width trades for.
  overflow-wrap anywhere

.data-view-generation__explanation,
.data-view-generation__refusal
  border 1px solid rgba(2, 136, 209, 0.35)
  background rgb(229, 246, 253)
  color rgb(1, 67, 97)

.data-view-generation__error
  border 1px solid rgba(211, 47, 47, 0.35)
  background rgb(253, 237, 237)
  color rgb(95, 33, 32)
