// Right-aligned row for surfaces that give the link a row of its own — the
// league home page's identity section, and the league team page.
.copy-markdown-button-row
  display flex
  justify-content flex-end
  padding 12px 16px

// Subtle inline link — muted, borderless, matches the 12px Inter meta text it
// sits alongside so it reads as a secondary action, not a prominent button.
.copy-markdown-button
  display inline-flex
  align-items center
  gap 4px
  padding 0
  border 0
  background none
  cursor pointer
  color rgba(0, 0, 0, 0.6)
  font-family 'Inter', sans-serif
  font-size 12px
  font-weight 400
  line-height 1

  // 14px explicitly, not via font-size. This was `svg { font-size: 14px }`
  // paired with MUI's `fontSize='inherit'`, which resolved the glyph to 1em —
  // a chain that only worked because SvgIcon sized itself in em. A plain svg
  // takes its box from width and height, and ignores font-size entirely.
  .icon
    width 14px
    height 14px

  &:hover
    color rgba(0, 0, 0, 0.87)
