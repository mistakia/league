html
  height 100%
  width 100%
  overflow hidden
  text-size-adjust 100%
  -webkit-font-smoothing: antialiased
  -moz-osx-font-smoothing: grayscale
  text-rendering: optimizeLegibility

body
  position relative
  font-family "Inter", "Helvetica", "Arial", sans-serif
  font-size 14px
  color $textColor
  height 100%
  width 100%
  overflow hidden
  // Only ever seen as the ios web app status bar and as overscroll, since
  // #root covers everything else. It was MUI's #1976d2 until bae8f8a11 — the
  // surface unification is reverted, but that blue is not coming back, since
  // it is one of the Material defaults this component set was taken off.
  background-color $backgroundColor

main
#root
  height 100%
  background-color $backgroundColor

.initializing__backdrop.MuiBackdrop-root
  z-index $z_app_backdrop
  color white
