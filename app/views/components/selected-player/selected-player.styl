.selected__player-paper.MuiDrawer-paper
  // Fixed viewport-based height: the MUI modal root is fixed inset-0, so 100%
  // is the viewport and the sheet covers it minus the top peek. The banner
  // term keeps the sheet top clear of the pause banner when it shows. If this
  // declaration ever becomes invalid at computed-value time (the var must
  // always resolve to a LENGTH — a unitless value makes the whole calc
  // invalid), the sheet silently falls back to MUI's content-height
  // `height: auto; max-height: 100%` and the bounded flex chain below it
  // collapses with it.
  height calc(100% - 64px - var(--app-banner-height, 0px))
  border-radius 36px 36px 0 0

.MuiModal-root:has(> .MuiPaper-root.selected__player-paper)
  z-index $z_selected_player

// The paper is a flex column (MUI's DrawerPaper) of exactly three items —
// header, main and the actions bar — and its height is the fixed calc above.
// main and the tab body inside it are bounded as flex items with min-height 0,
// so the tab body is the only surface that scrolls vertically. No percentage
// heights in this chain: they only work while the paper's calc holds, and the
// failure they produce when it does not is the clipped-and-unreachable body
// from 2026-08-14.
.selected__player-header
  flex 0 0 auto
  display flex
  align-items stretch
  label
    font-size 9px
    font-family "Inter", "Helvetica", "Arial", sans-serif;
    font-weight 300
    text-transform uppercase
    display block
    padding-bottom 2px
    display flex
    justify-content center
    text-align center
    color rgba(0, 0, 0, 0.6)

  .player__watchlist-action
    margin 0 16px 0 8px

  .player__name
    flex 0 0 auto

.selected__player-header-item
  flex 0 0 auto
  font-weight 700
  font-size 18px
  display flex
  flex-direction column
  justify-content center
  align-items center
  min-width 56px
  padding 4px 12px

  span
    white-space nowrap

  .selected__player-draft-round
    font-size 12px
    font-weight 400
    color rgba(0, 0, 0, 0.5)
    margin-left 2px

@media (max-width 400px)
  .selected__player-header-item
    flex 1 1 10%

.selected__player-season-stats
  display flex
  gap 12px
  align-items center
  margin 0 8px

.selected__player-season-stats-group
  display flex
  flex-direction column
  align-items center
  justify-content center
  background rgba(0, 0, 0, 0.03)
  border-radius 8px
  padding 6px 10px

.selected__player-season-stats-label
  font-size 9px
  font-family "Inter", "Helvetica", "Arial", sans-serif
  font-weight 500
  text-transform uppercase
  color rgba(0, 0, 0, 0.5)
  text-align center
  padding-bottom 4px
  letter-spacing 0.5px

.selected__player-season-stats-cells
  display flex
  gap 4px

.selected__player-season-stat
  display flex
  flex-direction column
  align-items center
  justify-content center
  padding 2px 6px

  label
    font-size 8px
    font-weight 400
    text-transform uppercase
    padding-bottom 2px
    color rgba(0, 0, 0, 0.4)

  .stacked-metric
    border-radius 6px
    min-width auto
    flex 0 0 auto
    width auto
    padding 4px 8px

  .stacked-metric__value
    font-size 16px
    font-weight 700

  .stacked-metric__ranks
    font-size 9px

@media (max-width 600px)
  .selected__player-season-stats
    flex-wrap wrap
    gap 6px

  .selected__player-season-stats-group
    flex 1 1 45%

.selected__player-header-secondary
  flex 1
  display flex
  background white
  flex-direction column
  min-height fit-content
  row-gap 8px
  padding 8px 0
  align-items center
  justify-content center

.selected__player-header-section
  flex 1
  display flex
  flex-wrap wrap
  justify-content flex-start
  align-items center
  row-gap 10px
  column-gap 4px
  height fit-content
  padding 0 8px

.selected__player-main
  flex 1 1 0
  min-height 0
  display flex
  flex-direction column
  overflow hidden

  .base-TabPanel-root
    flex 1 1 0
    min-height 0
    overflow-y scroll
    padding-bottom 16px

  .base-TabsList-root
    flex 0 0 52px

.selected__section
  padding 16px
  display flex
  flex-direction column
  max-width fit-content
  margin 0 auto
  border-radius 10px
  background white
  margin-bottom 16px
  overflow-y scroll
  &:first-child
    margin-top 16px

.selected__table
  height 100%
  max-width fit-content
  margin 0 auto
  overflow scroll
  padding-bottom 32px

  .MuiTab-root
    min-width 40px
    padding 0
    opacity 1

.selected__table-header
  flex 1
  display flex
  align-items stretch
  font-weight 500
  border-bottom 1px solid $borderColor
  font-size 12px
  min-width fit-content
  background rgb(245, 245, 245)

  &.sticky
    position sticky
    top 0
    z-index 2

.player__selected-row
  flex 1
  display flex
  height 24px
  line-height 16px
  align-items stretch
  min-width fit-content
  &:hover
    background $yellowColor

  &.header
    border-bottom 1px solid #f0f0f0

  &.POST
    background lighten(red, 95%)

    .table__cell.game__week
    .table__cell.game__day
      background lighten(red, 80%)

  &.PRE
    background lighten(gray, 96%)

    .table__cell.game__week
    .table__cell.game__day
      background lighten(gray, 80%)

.selected__player-action
  absolute top 16px right 16px
  width 45px
  height 45px
  display flex
  justify-content flex-end
  padding-top 8px
  padding-right 8px

  &:hover .icon
    fill $accentColor
    cursor pointer

// The MUI base Tabs root: a flex column of the tabs list (fixed 52px, set
// above) and the active tab panel, which takes the rest and scrolls.
.selected__player-menu
  flex 1 1 0
  min-height 0
  display flex
  flex-direction column
  overflow hidden

.selected__player-actions-container
  flex 0 0 auto
  display flex
  align-items center
  background lighten($backgroundColor, 50%)
  border-top 1px solid $borderColor
  justify-content flex-end
  align-items stretch
  .button
    white-space nowrap
    +button_override()
      font-size 10px

.selected__player-actions-close
  display flex
  justify-content center
  align-items center
  padding 16px
  border-left 1px solid $borderColor

.selected__player-actions
  padding 16px
  display flex
  align-items center
  gap 8px
  overflow-x scroll

@media (max-width 600px)
  .selected__player-actions-container
    // A bigger touch target on a phone. min-height is not a property
    // button.styl sets, so it needs no override chain.
    .button
      min-height 32px

  .selected__player-actions
  .selected__player-actions-close
    padding 16px 16px 32px

@media (min-width 951px)
  .selected__player-header
    .player__headshot
      border-radius 0

@media (max-width 950px)
  .selected__player-header .player__headshot
    margin 8px 0 0 8px

@media (max-width 950px)
  .selected__player-header-section
    justify-content center

  .selected__player-header
    flex-wrap wrap
    .player__name
      padding 8px 0

  .selected__player-header-section .button
    +button_override()
      font-size 9px

  .selected__player-header-secondary
    flex-basis 100%
