.auction__controls
  position fixed
  bottom 0
  left 0
  right 0
  flex 0 0 auto
  display flex
  flex-direction column
  border-top 1px solid $borderColor
  background white
  z-index 1

// WHAT THE CHROME IS, for the pages that are not the auction. A DEFINITE
// height rather than padding around the text: the two fallback constants have
// to stay equal to the resting height of this box (see the note at the foot of
// this file), and a row whose height is derived from its line-height makes that
// arithmetic something the next reader has to redo.
.auction__controls-label
  display flex
  flex 0 0 auto
  align-items center
  gap 8px
  height 24px
  padding 0 8px
  border-bottom 1px solid $borderColor
  font-size 11px
  text-transform uppercase
  letter-spacing 0.5px
  // The bar is chrome over someone else's page, so the label states itself
  // without competing with the board beneath it.
  color rgba(0, 0, 0, 0.78)
  a
    color inherit
    text-decoration none
    &:hover
      text-decoration underline

.auction__controls-label-league
  text-transform none
  letter-spacing 0
  color rgba(0, 0, 0, 0.6)
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

.auction__teams
  display flex
  flex-wrap nowrap
  align-items center
  background white
  padding-bottom 24px
  border-top 1px solid $borderColor
  border-bottom 1px solid $borderColor

@media (max-width 800px)
  .auction__teams
    overflow-x scroll
    overflow-y hidden

@media (min-width 1000px)
  .auction__teams
    justify-content center

// `min-height`, NOT `height`, and this box publishes what it actually measures.
// A definite height does not grow for its content, so once the bid bar's actions
// row wraps below 536px the surplus came out of the LAST CHILD -- the team strip
// -- rather than out of the box, which reads as a clipped chip row instead of as
// chrome that needs more room. The floor keeps the resting height these numbers
// were tuned for and lets the one zone that needs more take it.
//
// auction-controls.js observes this element and publishes
// `--auction-controls-height`; page.styl reserves the band from that property
// and menu.styl offsets both floating buttons off it. The constants are the
// fallback for the frame before the observer runs, so they must stay equal to
// the resting height rather than to a maximum.
@media (min-width 1160px)
  .auction__controls
    transition margin 225ms cubic-bezier(0, 0, 0.2, 1) 0ms
    min-height $auctionHeightDesktop
  .menu__open .auction__controls
    margin-left $menuWidth

@media (max-width 1159px)
  .auction__controls
    min-height $auctionHeightMobile