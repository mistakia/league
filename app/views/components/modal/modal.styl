// The paint comes from the prose-form tokens (app/styles/prose-form.styl,
// injected into every stylesheet), so a dialog is set in the same ink and the
// same type as the controls it contains.
//
// FLAT, like the button. A dialog sits over a scrim, and a scrim is already the
// strongest separation a surface can have — a drop shadow on top of one is
// simulating a light source to restate something the darkness has said. The
// edge is a 1px rule.

.modal
  position fixed
  top 0
  right 0
  bottom 0
  left 0
  z-index $z_dialog
  display flex
  align-items center
  justify-content center
  padding 24px

.modal__scrim
  position absolute
  top 0
  right 0
  bottom 0
  left 0
  background rgba(23, 24, 26, 0.5)

.modal__panel
  position relative
  display flex
  flex-direction column
  // The panel is sized by its content up to a readable cap, rather than being
  // given a width. Every dialog here is a sentence and two buttons; a fixed
  // width would set the short ones adrift in their own whitespace.
  min-width 300px
  max-width 100%
  max-height 100%
  overflow-y auto
  background $prose_paper
  border 1px solid $prose_rule_strong
  border-radius 3px
  outline none

.modal__title
  padding 20px 24px 0
  prose_label()

.modal__content
  padding 16px 24px
  font-size 14px
  line-height 1.5
  color $prose_body

  // What DialogContentText used to be. Call sites write a plain paragraph now,
  // so the muted ink and the spacing between them belong here.
  p
    margin 0 0 12px
    &:last-child
      margin-bottom 0

.modal__actions
  display flex
  align-items center
  justify-content flex-end
  padding 8px 16px 16px
  // No gap: `.button + .button` in button.styl already carries the 8px between
  // a pair of buttons, and setting both would space them 16 apart.
