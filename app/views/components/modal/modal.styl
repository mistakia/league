// The paint comes from the prose-form tokens (app/styles/prose-form.styl,
// injected into every stylesheet), so a dialog is set in the same ink and the
// same type as the controls it contains.
//
// FLAT, like the button. A dialog sits over a scrim, and a scrim is already the
// strongest separation a surface can have — a drop shadow on top of one is
// simulating a light source to restate something the darkness has said. The
// edge is a 1px rule.

.modal
  position fixed
  top 0
  right 0
  bottom 0
  left 0
  z-index $z_dialog
  display flex
  align-items center
  justify-content center
  padding 24px

.modal__scrim
  position absolute
  top 0
  right 0
  bottom 0
  left 0
  background rgba(23, 24, 26, 0.5)

.modal__panel
  position relative
  display flex
  flex-direction column
  // The panel is sized by its CONTENT between a floor and a cap, rather than
  // being given a width. Every dialog here is a sentence and two buttons, so a
  // fixed width would set the short ones adrift in their own whitespace.
  //
  // The cap is what stops a long sentence — several of these interpolate a
  // player's full name and position into a paragraph — from running the panel
  // out to the width of the screen and putting the text at a measure nobody can
  // read. 480px holds a $field_width control plus the panel's 24px of padding
  // with room either side, and it is a MAX-WIDTH rather than a width so the
  // short confirmations still shrink to their sentence.
  //
  // A caller that needs a wider panel must raise max-width, not just set width:
  // max-width beats width in the cascade, so a bare `width: 600px` override
  // would be clamped back to this number. contribution-dialog sets both.
  min-width 300px
  max-width 480px
  max-height 100%
  overflow-y auto
  background $prose_paper
  border 1px solid $prose_rule_strong
  border-radius 3px
  outline none

// THE SIZES ARE IN PIXELS, NOT em, AND THAT IS THE POINT OF NOT CALLING
// prose_label() HERE. That mixin sets 0.9375em, which is right inside
// prose_page() because the page declares a 17px base for it to be relative to.
// The modal portals to document.body, and NO stylesheet in this app sets a
// font-size on body or html — so the em was resolving against the browser
// default and the title was rendering at 15px, a number nothing in the project
// chose. The tokens are still the prose language's; only the sizing is local.
.modal__title
  padding 20px 24px 0
  font-family $prose_mono
  font-weight $prose_bold
  // Large enough to be read as a heading rather than as a bold first line. Mono
  // sets wider than the body face at the same size, so this is a smaller step
  // up from the content than the numbers suggest, and it takes the negative
  // tracking mono needs above ~16px to stop looking like a terminal dump.
  font-size 17px
  line-height 1.35
  letter-spacing -0.01em
  color $prose_ink

.modal__content
  padding 16px 24px
  // 15px over 14px, and 1.6 leading over 1.5. These paragraphs are the only
  // prose in the app's chrome — several interpolate a player's full name and
  // position into a sentence and then explain a roster consequence — so they
  // are read rather than scanned, and they were set at the density of a table
  // cell. At 480px with 24px of padding either side the measure is about 60
  // characters, which is what the leading is sized for.
  font-size 15px
  line-height 1.6
  color $prose_body

  // What DialogContentText used to be. Call sites write a plain paragraph now,
  // so the ink and the spacing between them belong here. The gap is set in em
  // deliberately — this one IS relative to a font-size declared just above it,
  // so it tracks the text rather than drifting from it.
  p
    margin 0 0 0.75em
    &:last-child
      margin-bottom 0

.modal__actions
  display flex
  align-items center
  justify-content flex-end
  padding 8px 16px 16px
  // No gap: `.button + .button` in button.styl already carries the 8px between
  // a pair of buttons, and setting both would space them 16 apart.
