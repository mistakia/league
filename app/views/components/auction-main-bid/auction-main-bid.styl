.auction__bar
  flex 0 0 auto
  background $backgroundColor

.auction__bar-body
  flex 0 0 auto
  height 70px
  display flex
  max-width fit-content

// `min-width 0` because a flex item defaults to `min-width auto`, which refuses
// to shrink below its content and so converts any shortfall into overflow of
// the BAR rather than compression of this panel. With the election control in
// the strip the bar body ran 1445px inside a 1000px cap, putting the last
// button past the right edge of the viewport.
// The settlement status is NOT here. It names every team still to answer, so
// its length grows with the league and has no natural upper bound -- inside a
// 70px bar that made it either the thing setting the bar's width or, once
// bounded and clamped, a box with its own sentence cut off. It lives in
// `.auction__side` alone, where it is a paragraph that may take the height it
// needs. Nothing about it belongs in the bar's stylesheet.
.auction__bid-info
  flex 1
  min-width 0
  display flex

.auction__bid-actions
  flex 0 0 auto
  display flex
  align-items center

.auction__main-input
  flex 0 0 auto
  position relative
  height 100%
  input
    border none
    width 60px
    height 100%
    text-align center
    font-size 20px
    padding-top 12px
    background #fafafa
    font-family 'IBM Plex Mono', monospace
    &::-webkit-inner-spin-button
    &::-webkit-outer-spin-button
      -webkit-appearance none
      margin 0
  label
    absolute top 4px right
    text-align center
    width 60px
    font-size 9px
    font-weight 300
    text-transform uppercase

.auction__main-action
  flex 0 0 auto
  padding 0 16px
  display flex
  align-items center
  gap 8px
  .button
    min-width 150px

.auction__main-timer
  position relative
  flex 0 0 60px
  height 100%
  display flex
  justify-content center
  align-items center
  user-select none

.auction__text
  font-weight 600
  font-size 1.5em
  display flex
  align-items center
  .team__name
    line-height 1.5em

// The stepper goes green while you hold the winning bid. `winning` is pushed
// onto the group's className in auction-main-bid.js; it reached the buttons
// through MUI's own group classes until the group became @components/button-group.
.button-group.winning > .button
  +button_override()
    background rgb(46, 125, 50)
    color rgba(255,255,255,0.8)

@media (min-width 800px)
  .auction__bid-actions
    height 100%
    background white

// 1120px rather than 1000px, and the breakpoint moves with it so the cap is
// never wider than the viewport that opts into it.
//
// The cap is what decides whether the nominated player fits. `.auction__bid-actions`
// is fixed-content (timer, stepper, election control, bid input) and took 593px
// measured, so the bar's cap minus that is all `.auction__bid-info` ever gets.
// At 1000px that was 407px for 468px of content -- a 264px name beside a 204px
// details group -- and since both are flex items that had run out of room to
// shrink, the surplus became overlap: "MARKET $0" printed on top of "PICKETT".
// Giving the bar the extra 120px is the one fix here that costs no content;
// every alternative was dropping a detail column or clipping the player's name
// on the surface whose subject IS that player.
@media (min-width 1160px)
  .auction__bar-body
    max-width 1120px
    margin 0 auto

// Paired with the cap above: below the width where the bar is centred and
// bounded, it runs edge to edge and the text needs its own gutter. The two
// boundaries move together or a band opens up that is full-bleed AND unpadded.
@media (max-width 1159px)
  .auction__text
    padding 0 16px

@media (max-width 799px)
  .auction__bar
    display flex
    align-items center
    justify-content center

  .auction__bar-body
    flex-direction column
    height 120px
    align-items flex-start

  .auction__bid-actions
    padding 0 16px 8px
    justify-content center
    width 100%

  .auction__bid-info
    height 105px
    position relative

  .auction__main-timer
    border-radius 8px
    overflow hidden

@media (max-width 400px)
  .auction__main-timer
    flex 0 0 30px

// Lives in `.auction__bid-info` beside the settlement status, not inside the
// 60px timer box it used to share a row with. Given the same shape as the
// status it alternates with, so the slot does not jump between live and
// election mode.
.auction__block-label
  flex 0 0 auto
  align-self center
  margin-right 10px
  padding 4px 8px
  font-size 10px
  line-height 1.3
  text-transform uppercase
  letter-spacing 0.5px
  opacity 0.7
