// Literal values rather than stylus tokens, matching the sibling
// data-view-notices.styl. An undefined stylus variable is emitted as a bare
// ident and the declaration is silently discarded, so a token that does not
// exist in this tree costs a rule with no error anywhere.
//
// react-table's own $rt_* tokens are exactly that here. Its stylesheets are
// compiled by THIS app's stylus-loader, which injects app/styles/variables.styl
// and nothing from the library, so every $rt_* declaration in the library is
// dropped -- including the `padding $rt_space_xl $rt_space_lg` on the
// .table-empty-state wrapper, which computes to 0px. This block therefore owns
// its own padding and its own alignment rather than inheriting either.

// Anchored left rather than centred in the table area. The wrapper is
// `position: sticky; left: 0` inside a horizontal scroll container and is
// `width: fit-content`, so centring a child would put it at the middle of the
// SCROLL width -- off screen at any scroll offset on a wide table, which is
// the exact failure the sticky rule exists to prevent.
.data-view-empty-state
  max-width 620px
  // Aligns the text with the first data column: the wrapper starts at the
  // table's left edge, and the header row starts one row-number gutter in.
  padding-left var(--rt-column-index-width, 30px)
  padding-right 16px
  padding-top 24px
  padding-bottom 28px
  color rgba(0, 0, 0, 0.62)
  font 400 14px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif

  strong
    font-weight 600
    color rgba(0, 0, 0, 0.87)

.data-view-empty-state__headline
  margin-bottom 6px
  color rgba(0, 0, 0, 0.87)
  font-size 17px
  font-weight 600
  line-height 1.35
  letter-spacing -0.01em

.data-view-empty-state__lede
  margin-bottom 18px

// A RULE, NOT A BOX. The tutorial is the least important thing here and a
// bordered, tinted panel made it the heaviest -- on an empty page it outweighed
// both the headline and the two controls the headline points at. A hairline and
// one quiet line say "there is more here" without competing for the first look.
.data-view-empty-state__quick-start
  margin-bottom 18px
  border-top 1px solid rgba(0, 0, 0, 0.12)

// Set like the links at the foot of this block, because that is what it is: a
// word that reveals more reading. It is the whole control -- once the steps are
// shown it is gone, and nothing takes its place.
.data-view-empty-state__reveal
  display block
  margin 0
  padding 9px 0
  border 0
  background transparent
  color rgba(0, 0, 0, 0.55)
  font-family inherit
  font-size 13px
  text-align left
  text-decoration underline
  text-decoration-color rgba(0, 0, 0, 0.22)
  text-underline-offset 2px
  cursor pointer
  transition color 120ms ease, text-decoration-color 120ms ease

  &:hover
    color rgba(0, 0, 0, 0.87)
    text-decoration-color rgba(0, 0, 0, 0.6)

// Matches the reveal line's own padding, so the block does not shift the links
// below it when the steps replace the line.
.data-view-empty-state__panel
  padding 10px 0 12px

.data-view-empty-state__steps
  margin 0
  padding-left 20px

  li
    margin-bottom 10px

    &:last-child
      margin-bottom 0

    &::marker
      color rgba(0, 0, 0, 0.4)

.data-view-empty-state__tip
  margin-top 14px
  color rgba(0, 0, 0, 0.55)
  font-size 13px

.data-view-empty-state__links
  display flex
  gap 18px
  font-size 13px

  a
    color rgba(0, 0, 0, 0.6)
    text-decoration underline
    text-decoration-color rgba(0, 0, 0, 0.25)
    text-underline-offset 2px

    &:hover
      color rgba(0, 0, 0, 0.87)
      text-decoration-color rgba(0, 0, 0, 0.6)
