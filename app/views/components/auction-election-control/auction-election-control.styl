// The election control had NO stylesheet at all until 2026-09-02. It rendered
// as a bare label, a bare number input and two buttons inline in the
// selected-player header's flex row, top-aligned against the player headshot
// and competing with the stat items for the same axis. This gives it a band of
// its own so the layout does not have to be argued for at each of its two call
// sites.
//
// Three measures the band shares with the centring rule below, named so the
// remainder there is derived rather than copied. Stylus resolves variables in
// source order, so they must stay above every rule that reads them.
$election_control_state_basis = 132px
$election_control_gap = 12px
$election_control_content_max_width = 720px

.auction-election-control
  flex 0 0 auto
  display flex
  align-items stretch
  gap $election_control_gap
  padding 10px 16px
  border-top 1px solid $borderColor
  border-bottom 1px solid $borderColor
  background $backgroundColor

  label
    font-size 9px
    font-family "Inter", "Helvetica", "Arial", sans-serif
    font-weight 300
    text-transform uppercase
    letter-spacing 0.5px
    display block
    padding-bottom 2px
    color rgba(0, 0, 0, 0.6)

// The band spans the drawer but its content does not need to. Capping the
// content and centring the cap keeps the divider at a fixed offset and the note
// wrapping to a stable measure, so the group does not slide horizontally as the
// state moves between "None set", a dollar amount, a decline and a capped
// ceiling -- which is what centring the two children as a content-sized group
// would have done instead. The band keeps its full-bleed rules; only the flex
// line inside it is bounded.
//
// The body carries the cap because there is no wrapper element to put it on,
// and its remainder is derived rather than written: every box here is
// border-box (normalize.css sets it on `*`), so the state column's outer width
// IS its 132px basis and the whole group is state + gap + body.
//
// SCOPED OFF COMPACT DELIBERATELY, not left to specificity. `.compact` is the
// strip inside the 70px live bid bar and it shares every base declaration
// above, so an unscoped `justify-content` here would reach it too.
.auction-election-control:not(.compact)
  justify-content center

  .auction-election-control__body
    max-width $election_control_content_max_width - $election_control_state_basis - $election_control_gap

// The current election, stated before anything offers to change it. A fixed
// basis rather than content width so the form beside it does not shift
// horizontally when the state goes from "None set" to "$12".
.auction-election-control__state
  flex 0 0 $election_control_state_basis
  display flex
  flex-direction column
  justify-content center
  border-right 1px solid $borderColor
  padding-right 12px

.auction-election-control__state-value
  font-size 20px
  font-weight 700
  line-height 1.1
  white-space nowrap

// A decline is not a $0 maximum, and the two must not read alike at a glance --
// the same distinction auction-election-chip carries on the board. The amount
// is the loud one because it is a live claim; a decline is an answer already
// given, so it recedes without disappearing.
.auction-election-control
  &.maximum .auction-election-control__state-value
    color $accentColor

  &.declined .auction-election-control__state-value
    color lighten(black, 45%)
    font-weight 400

  &.settled
    opacity 0.7

    .auction-election-control__state-value
      font-size 15px

.auction-election-control__body
  flex 1 1 auto
  display flex
  flex-direction column
  justify-content center
  gap 6px
  min-width 0

.auction-election-control__form
  display flex
  align-items center
  flex-wrap wrap
  gap 8px

  label
    padding-bottom 0

  input
    box-sizing border-box
    width 96px
    height $control_height
    padding 0 8px
    font-size 16px
    font-weight 700
    border 1px solid $borderColor
    border-radius $button_border_radius
    background white

    &:focus
      outline none
      border-color $accentColor

.auction-election-control__note
  font-size 11px
  line-height 1.4
  color rgba(0, 0, 0, 0.6)

// On a phone the drawer header already wraps to several rows, so the state and
// the form stack rather than sharing a line, and the divider becomes horizontal.
@media (max-width 700px)
  .auction-election-control
    flex-direction column
    gap 8px
    padding 10px 12px

  .auction-election-control__state
    flex 0 0 auto
    flex-direction row
    align-items baseline
    gap 8px
    border-right none
    border-bottom 1px solid $borderColor
    padding 0 0 6px

    label
      padding-bottom 0

// The live bid bar. A strip rather than a page band: no rules, no ground and no
// note, because the bar around it already carries the player, the price and the
// clock. The state line stays -- whether you already hold a ceiling on the open
// player is exactly what a manager checks before bidding.
.auction-election-control.compact
  flex 0 0 auto
  padding 0 8px
  gap 8px
  border none
  background transparent
  align-items center

  // STACKED, like its drawer twin, rather than laid out as a row. This block
  // read `YOUR ELECTION $5` on one line to save vertical room in a 70px bar,
  // which put a 9px uppercase label and a 14px amount on one baseline and made
  // the label look like a prefix to the number rather than its caption. Stacked
  // it costs 27px of the bar's 70 and matches how every other captioned value
  // in the bar is built -- MARKET, BYE and AGE are all label-over-value.
  //
  // No `flex-direction` here at all: the base block already says `column`, so
  // stacking is the absence of the override rather than a second declaration
  // restating it.
  .auction-election-control__state
    flex 0 0 auto
    border-right none
    padding-right 8px

  .auction-election-control__state-value
    font-size 14px

  // The compact form is one button, so wrapping can only ever produce a second
  // row inside a fixed-height strip -- there is nothing for it to wrap TO.
  .auction-election-control__form
    flex-wrap nowrap
    white-space nowrap
