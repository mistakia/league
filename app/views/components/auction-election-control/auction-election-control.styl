// The election control had NO stylesheet at all until 2026-09-02. It rendered
// as a bare label, a bare number input and two buttons inline in the
// selected-player header's flex row, top-aligned against the player headshot
// and competing with the stat items for the same axis. This gives it a band of
// its own so the layout does not have to be argued for at each of its two call
// sites.
//
// Three measures the band shares with the centring rule below, named so the
// remainder there is derived rather than copied. Stylus resolves variables in
// source order, so they must stay above every rule that reads them.
$election_control_state_basis = 132px
$election_control_gap = 12px
$election_control_content_max_width = 720px

.auction-election-control
  flex 0 0 auto
  display flex
  align-items stretch
  gap $election_control_gap
  padding 10px 16px
  border-top 1px solid $borderColor
  border-bottom 1px solid $borderColor
  background $backgroundColor

  label
    font-size 9px
    font-family "Inter", "Helvetica", "Arial", sans-serif
    font-weight 300
    text-transform uppercase
    letter-spacing 0.5px
    display block
    padding-bottom 2px
    color rgba(0, 0, 0, 0.6)

// The band spans the drawer but its content does not need to. Capping the
// content and centring the cap keeps the divider at a fixed offset and the note
// wrapping to a stable measure, so the group does not slide horizontally as the
// state moves between "None set", a dollar amount, a decline and a capped
// ceiling -- which is what centring the two children as a content-sized group
// would have done instead. The band keeps its full-bleed rules; only the flex
// line inside it is bounded.
//
// The body carries the cap because there is no wrapper element to put it on,
// and its remainder is derived rather than written: every box here is
// border-box (normalize.css sets it on `*`), so the state column's outer width
// IS its 132px basis and the whole group is state + gap + body.
//
// SCOPED OFF COMPACT DELIBERATELY, not left to specificity. `.compact` is the
// strip inside the 70px live bid bar and it shares every base declaration
// above, so an unscoped `justify-content` here would reach it too.
.auction-election-control:not(.compact)
  justify-content center

  .auction-election-control__body
    max-width $election_control_content_max_width - $election_control_state_basis - $election_control_gap

// The current election, stated before anything offers to change it. A fixed
// basis rather than content width so the form beside it does not shift
// horizontally when the state goes from "None set" to "$12".
.auction-election-control__state
  flex 0 0 $election_control_state_basis
  display flex
  flex-direction column
  justify-content center
  border-right 1px solid $borderColor
  padding-right 12px

.auction-election-control__state-value
  font-size 20px
  font-weight 700
  line-height 1.1
  white-space nowrap

// A decline is not a $0 maximum, and the two must not read alike at a glance --
// the same distinction auction-election-chip carries on the board. The amount
// is the loud one because it is a live claim; a decline is an answer already
// given, so it recedes without disappearing.
.auction-election-control
  &.maximum .auction-election-control__state-value
    color $accentColor

  &.declined .auction-election-control__state-value
    color lighten(black, 45%)
    font-weight 400

  &.settled
    opacity 0.7

    .auction-election-control__state-value
      font-size 15px

.auction-election-control__body
  flex 1 1 auto
  display flex
  flex-direction column
  justify-content center
  gap 6px
  min-width 0

.auction-election-control__form
  display flex
  align-items center
  flex-wrap wrap
  gap 8px

  label
    padding-bottom 0

  input
    box-sizing border-box
    width 96px
    height $control_height
    padding 0 8px
    font-size 16px
    font-weight 700
    border 1px solid $borderColor
    border-radius $button_border_radius
    background white

    &:focus
      outline none
      border-color $accentColor

.auction-election-control__note
  font-size 11px
  line-height 1.4
  color rgba(0, 0, 0, 0.6)

// On a phone the drawer header already wraps to several rows, so the state and
// the form stack rather than sharing a line, and the divider becomes horizontal.
//
// SCOPED OFF COMPACT, and it was not before -- this is the same mistake this
// file already warns about for `justify-content` fifty lines up, made again with
// a media query instead of a bare rule. These selectors were unqualified, so
// everything here also reached the strip inside the live bid bar: at 600 the
// compact control grew a horizontal divider it has no room for and its state
// went from stacked to a baseline row, taking it from 26px to 54px against
// neighbours that are 26. That is a doubled control in a row that had already
// run out of width, so it wrapped, and the wrap is most of what reads as the
// mobile bid area being poorly aligned. Measured at 600 before this: control
// 54px tall inside a 143px bar; the same control at 1024 was 26px.
//
// A media query adds no specificity, which is what made this invisible from the
// stylesheet -- the compact block outranks these selectors on every property it
// declares, so the only ones that leaked through are the ones compact never
// mentions. Those are exactly the four here.
@media (max-width 700px)
  .auction-election-control:not(.compact)
    flex-direction column
    gap 8px
    padding 10px 12px

  .auction-election-control:not(.compact) .auction-election-control__state
    flex 0 0 auto
    flex-direction row
    align-items baseline
    gap 8px
    border-right none
    border-bottom 1px solid $borderColor
    padding 0 0 6px

    label
      padding-bottom 0

// The live bid bar. A strip rather than a page band: no rules, no ground and no
// note, because the bar around it already carries the player, the price and the
// clock. The state line stays -- whether you already hold a ceiling on the open
// player is exactly what a manager checks before bidding.
// SCOPED BY `.compact`, WHICH IS A CLASS AND NOT A MEDIA QUERY, so everything
// below is confined to the bar however narrow the drawer gets. The reverse
// mistake -- an unqualified selector inside a `max-width` block -- is what the
// note above this one is about.
.auction-election-control.compact
  // `flex 0 1 auto` and `min-width 0`: this is the widest atom on the bar's
  // actions row at 315px, so it is the one that has to give when the row wraps.
  // With `flex 0 0 auto` it kept its 315px inside whatever it was handed and
  // overflowed instead.
  flex 0 1 auto
  min-width 0
  padding 0 8px
  gap 8px
  border none
  background transparent
  align-items center
  // THE STATE DROPS BELOW THE FORM BEFORE THE FORM BREAKS IN HALF. Both this
  // and the form wrap, and the order they give way in is what decides how the
  // control reads on a 280px screen: state over a single row of buttons is
  // still a caption and its two actions, where `Your election / $5 / Decline`
  // on one line and `Change maximum` orphaned on the next is not.
  //
  // Wrapping here is what takes the control's floor from 284.8px to the widest
  // single button on it -- `Change maximum` at 125.5px -- which is what puts a
  // 280px screen in reach at all.
  flex-wrap wrap
  justify-content center
  row-gap 6px

  // STACKED, like its drawer twin, rather than laid out as a row. This block
  // read `YOUR ELECTION $5` on one line to save vertical room in a 70px bar,
  // which put a 9px uppercase label and a 14px amount on one baseline and made
  // the label look like a prefix to the number rather than its caption. Stacked
  // it costs 27px of the bar's 70 and matches how every other captioned value
  // in the bar is built -- MARKET, BYE and AGE are all label-over-value.
  //
  // No `flex-direction` here at all: the base block already says `column`, so
  // stacking is the absence of the override rather than a second declaration
  // restating it.
  .auction-election-control__state
    flex 0 0 auto
    border-right none
    padding-right 6px

  // 12px AND 600, down from 14px and the base block's 700. This is a STATUS,
  // not a control: it says what you have already committed, and everything
  // beside it in the row -- the stepper, the decline, the bid input -- is
  // something you can act on right now. At 14/700 it was the heaviest thing on
  // the row and read as the row's subject.
  //
  // The stacked caption shape is deliberately NOT touched. It was a row once,
  // and `YOUR ELECTION $5` on one baseline made the 9px uppercase label read as
  // a prefix to the number rather than its caption; it also stopped matching
  // MARKET and LIVE VALUE, which are label-over-value a few inches to the left.
  // Smaller is the ask, and smaller is available without reopening that.
  .auction-election-control__state-value
    font-size 12px
    font-weight 600

  // IT WRAPS NOW, and the comment this replaces was true when it was written
  // and is not any more. It read: "the compact form is one button, so wrapping
  // can only ever produce a second row inside a fixed-height strip -- there is
  // nothing for it to wrap TO." Two of those three premises have moved. The form
  // is TWO buttons since the bar gained its route to a maximum (`Decline` at
  // 65px and `Change maximum` at 125.5px), and the strip is no longer
  // fixed-height -- `.auction__bar-body` took `min-height` with `height auto`,
  // and `.auction__controls` now publishes what it measures rather than
  // reserving a constant. There is somewhere to wrap to.
  //
  // `white-space nowrap` STAYS. It stops a label breaking mid-phrase, which is a
  // different question from whether the buttons may sit on two rows, and
  // `Change / maximum` split over two lines inside a 26px button is the defect
  // that keeps it here.
  .auction-election-control__form
    flex-wrap wrap
    justify-content center
    row-gap 6px
    white-space nowrap

// THE PHONE LAYOUT OF THE COMPACT STRIP, and it is a different shape rather than
// a smaller one. Paired with the `max-width 535px` block in auction-main-bid.styl
// -- the two are one layout written in two files because the boxes they place
// belong to two components, and the breakpoint has to be the same number in both.
//
// STILL SCOPED BY `.compact`, WHICH IS A CLASS. Every selector here carries it,
// so none of this can reach the drawer's copy of the control however narrow the
// drawer gets. That is the mistake the note fifty lines up is about, and a media
// query adds no specificity to stop it.
@media (max-width 535px)
  // `display contents` DISSOLVES THIS BOX so its two children become items of
  // the bar's grid directly. They have to be placed on different rows of it --
  // the state on its own line, the form beside the stepper -- and a child cannot
  // be placed on its grandparent's grid while its parent is still a box between
  // them.
  //
  // The box carried nothing but layout: `background transparent`, `border none`
  // and padding the grid now supplies. The one exception is `opacity` for a
  // settled election, which cannot apply to a box that no longer exists, so it
  // moves onto the state below.
  .auction-election-control.compact
  .auction-election-control.compact .auction-election-control__body
    display contents

  .auction-election-control.compact.settled .auction-election-control__state
    opacity 0.7

  // ALONG THE LINE, NOT STACKED, and the argument that made it stacked does not
  // hold here. It was stacked because `YOUR ELECTION $5` on one baseline read as
  // a prefix to the number rather than as its caption -- true when it sat in a
  // row of controls, where the eye groups horizontally. On its own full-width
  // line there is nothing beside it to be confused with, and the caption reads as
  // a caption again. Stacked it costs 27px of a bar that has none to give; along
  // the line it costs one 15px row.
  //
  // `baseline` rather than `center`, so the 9px label and the 12px amount sit on
  // one line of type instead of two boxes centred on each other.
  .auction-election-control.compact .auction-election-control__state
    grid-area state
    flex-direction row
    align-items baseline
    justify-content flex-start
    gap 6px
    padding-right 0
    border-right none

    // The 2px was the gap under a caption sitting ON its value. Beside it, it is
    // a nudge off the baseline the two now share.
    label
      padding-bottom 0

  .auction-election-control.compact .auction-election-control__form
    grid-area form
    // `nowrap`, undoing the wrap above: this row is the one that scrolls, and a
    // row that wraps never overflows and so never scrolls. The scroll container
    // is `.auction__main-action` in auction-main-bid.styl.
    flex-wrap nowrap
    justify-content flex-start
