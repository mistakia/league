// THE LAYER IS THE MODAL'S, not this component's. `.contribution-dialog` is a
// className handed to @components/modal, so it lands on the same element as
// `.modal` — which already takes $z_dialog from the named scale in
// app/styles/variables.styl. Restating it here would be a second place to
// change if the scale ever moves.
//
// The reasoning that put it on the scale still holds and is worth keeping:
// $z_dialog already sits above $z_selected_player and the react-table band, and
// $z_snackbar is above it, so the submit toast renders over the open dialog
// rather than behind it.
.contribution-dialog
  // What MUI's `maxWidth='sm' fullWidth` was: 600px, or the viewport if it is
  // narrower. The modal's own `max-width: 100%` supplies the second half.
  .modal__panel
    width 600px

  &__kind
    margin-bottom 8px

  &__context
    margin-top 16px
    box-shadow none
    border 1px solid rgba(0, 0, 0, 0.12)

  &__context-preview
    margin 0
    max-height 240px
    overflow auto
    font-size 11px
    line-height 1.4
    white-space pre-wrap
    word-break break-all

  &__screenshot
    margin-top 8px

  // Bounded so a tall capture cannot push the submit buttons off screen. The
  // preview exists to let the submitter recognise what they are attaching, not
  // to be read at full size.
  &__screenshot-preview
    display block
    width 100%
    max-height 220px
    object-fit contain
    object-position top
    border 1px solid rgba(0, 0, 0, 0.12)
    border-radius 4px
    background rgba(0, 0, 0, 0.02)

  &__receipt-lead
    margin-top 0

  &__claim
    margin-top 12px
    padding 8px
    background rgba(0, 0, 0, 0.04)
    border-radius 4px
    font-size 12px
    word-break break-all
