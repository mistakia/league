// No card and no inset. The page names its sections against one left edge, and
// the league's own name is the headline that edge is set by — a padded white
// panel put the h1 32px inside every label beneath it.
.league__header
  padding 8px 0
  font-family 'IBM Plex Mono', monospace
  h1
    font-weight 100
    margin-bottom 0

  .MuiChip-label
    font-family 'IBM Plex Mono', monospace
    padding 0 6px

  // Matches the rule the page's other section headings carry
  .heading__section-title
    padding 16px 0 8px
    border-bottom 1px solid $textColor

  .league__gloss
    padding 10px 0 14px

.league__chips
  align-items center
  flex-wrap wrap
  padding-bottom 24px

  // The format is context, not the headline. These read as a caption under the
  // league name rather than as a row of buttons.
  .MuiChip-root
    margin 6px 6px 0 0
    border-radius 3px
    height 18px
    font-size 10px
    letter-spacing 0.02em
    &.starters
      color white
    // The light fills take ink instead, which is what position-background-mixin
    // already does for these two and only these two. White on $wr_color
    // measures 1.69:1 — it was hard to read at 12px and unreadable at 10.
    &.wr, &.k
      color $textColorDark
    &.qb
      background $qb_color
    &.rb
      background $rb_color
    &.wr
      background $wr_color
    &.te
      background $te_color
    &.k
      background $k_color
    &.dst
      background $dst_color
    &.qbrbwrte
      background $qbrbwrte_color
    &.rbwrte
      background $rbwrte_color
    &.rbwr
      background $rbwr_color
