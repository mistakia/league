.league__header
  background white
  padding 8px 32px
  border-radius 16px
  font-family 'IBM Plex Mono', monospace
  h1
    font-weight 100
    margin-bottom 0

  .MuiChip-label
    font-family 'IBM Plex Mono', monospace

  // The card already carries the horizontal padding the heading and its gloss
  // add, and a gloss inset past its own heading reads as a different block
  .heading__section-title
    padding 16px 0 0

  .league__gloss
    padding 4px 0 12px

.league__chips
  align-items center
  flex-wrap wrap
  padding-bottom 24px

  .MuiChip-root
    margin 8px 0 0 8px
    border-radius 3px
    &.starters
      color white
    &.qb
      background $qb_color
    &.rb
      background $rb_color
    &.wr
      background $wr_color
    &.te
      background $te_color
    &.k
      background $k_color
    &.dst
      background $dst_color
    &.qbrbwrte
      background $qbrbwrte_color
    &.rbwrte
      background $rbwrte_color
    &.rbwr
      background $rbwr_color
