// No card and no inset. The page names its sections against one left edge, and
// the league's own name is the headline that edge is set by — a padded white
// panel put the h1 32px inside every label beneath it.
.league__header
  padding 8px 0
  font-family 'IBM Plex Mono', monospace
  h1
    font-weight 100
    margin-bottom 0

  .MuiChip-label
    font-family 'IBM Plex Mono', monospace

  // Matches the rule the page's other section headings carry
  .heading__section-title
    padding 16px 0 8px
    border-bottom 1px solid $textColor

  .league__gloss
    padding 10px 0 14px

.league__chips
  align-items center
  flex-wrap wrap
  padding-bottom 24px

  .MuiChip-root
    margin 8px 8px 0 0
    border-radius 3px
    &.starters
      color white
    &.qb
      background $qb_color
    &.rb
      background $rb_color
    &.wr
      background $wr_color
    &.te
      background $te_color
    &.k
      background $k_color
    &.dst
      background $dst_color
    &.qbrbwrte
      background $qbrbwrte_color
    &.rbwrte
      background $rbwrte_color
    &.rbwr
      background $rbwr_color
