// Twenty short rows of one fact each. At a 48px headshot and a 60px floor they
// took most of a screen to say very little, so the row is sized to its content.
//
// The class is doubled with `.transaction--wide` on purpose. That class sets
// `min-height: 60px` in transaction-row.styl for the transactions page, whose
// virtualized list needs a fixed row height; at a bare class this rule ties it
// at (0,1,0) and loses on chunk order, silently, with the CSS right there.
.league__recent-transaction.transaction--wide
  display flex
  align-items center
  border-bottom 1px solid $borderColor
  min-height fit-content
  padding 2px 0
  .transaction__timestamp
    display flex
    align-items center
    font-size 11px
    margin-left 4px
    padding-left 4px
    color rgba(0,0,0,0.4)
    flex 0 0 20px
    margin 8px 0

.league__recent-transactions
  display grid
  grid-template-columns repeat(auto-fit, minmax(280px, 1fr))
  gap 16px
  width 100%

// Two halves of one block, separated from the page by the rule under each
// label rather than by a bordered box — the page structures by rule.
.transactions__section
  display flex
  flex-direction column
  height fit-content

.transactions__section-title
  font-family 'IBM Plex Mono', monospace
  letter-spacing .2em
  text-transform uppercase
  font-size 12px
  font-weight 800
  padding 0 0 8px
  border-bottom 1px solid $textColor
