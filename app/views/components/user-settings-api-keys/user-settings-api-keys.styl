.api-keys
  margin-top 16px

  &__description
    color rgba(0, 0, 0, 0.6)
    font-size 14px
    margin 0 0 16px

  &__create
    display flex
    align-items center
    gap 12px
    margin-bottom 16px

  &__generated
    margin-bottom 16px

  &__generated-value
    font-family monospace
    word-break break-all
    margin-top 8px

  &__empty
    color rgba(0, 0, 0, 0.6)
    font-size 14px

  &__revoked
    color rgba(0, 0, 0, 0.4)
    font-size 13px
