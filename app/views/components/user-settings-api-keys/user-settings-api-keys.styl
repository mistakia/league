// The controls here are native elements calling the shared prose-form mixins
// rather than MUI components. See the header comment in the component.

// Section spacing is the page's, not this component's — `.setting-section +
// .setting-section` in user-settings.styl owns the gap so it cannot differ
// between the two sections on the page.
.api-keys
  &__description
    color $prose_muted
    font-size 14px
    margin 0 0 16px

  &__create
    display flex
    align-items center
    gap 12px
    margin-bottom 16px

  &__create-input
    prose_input()
    flex 0 1 280px
    font-size 14px
    padding 8px 10px

  // THE GENERATED KEY IS THE ONE THING ON THIS PAGE THAT CANNOT BE READ TWICE,
  // so it is the one thing that gets to shout. It was prose_message's set-apart
  // left bar, which is the right weight for a standing note and far too quiet
  // for a value that is gone the moment the page is left.
  //
  // The bar is replaced by an inverted block: near-black ground, paper ink, no
  // border on any edge. Inversion is what makes it register at a glance — it is
  // the only dark surface on a page of white cards — and it stays flat, since
  // the contrast is doing the work a shadow would otherwise be asked to do.
  &__generated
    position relative
    margin-bottom 20px
    padding 16px 40px 16px 16px
    color $prose_paper
    background $prose_ink
    border-radius 3px

  &__generated-eyebrow
    margin-bottom 6px
    font-family $prose_mono
    font-weight 500
    font-size 11px
    letter-spacing 0.16em
    text-transform uppercase
    // The one muted thing inside the block: it names what this is, and the
    // sentence under it is what has to be read.
    color rgba(255, 255, 255, 0.55)

  &__generated-message
    font-size 14px
    line-height 1.5

  // The key sits on its own inset panel rather than loose on the ground. It is
  // the thing being copied, so it gets a selectable edge to aim at.
  &__generated-value
    margin-top 12px
    padding 10px 12px
    font-family $prose_mono
    font-size 14px
    line-height 1.5
    word-break break-all
    user-select all
    background rgba(255, 255, 255, 0.1)
    border-radius 3px

  &__generated-dismiss
    position absolute
    top 10px
    right 10px
    padding 0 4px
    font-size 18px
    line-height 1
    color rgba(255, 255, 255, 0.55)
    background transparent
    border none
    cursor pointer
    &:hover
      color $prose_paper

  &__empty
    color $prose_muted
    font-size 14px

  &__revoked
    color $prose_muted
    font-size 13px

  // The name field sits inside a table cell, so it reads as text until it is
  // touched: no border at rest, the shared input's border and ring on focus.
  &__name-input
    prose_input()
    width 100%
    padding 4px 6px
    font-size 14px
    background transparent
    border-color transparent
    &:hover
      border-color $prose_rule_strong

  &__name-static
    font-size 14px
    color $prose_muted

  // A four-column settings table, not the app's dense metric grid, so the head
  // drops to a single row height and the cells size to their content.
  .table__head
    height 32px

  .table__cell
    font-size 14px

  &__cell-name
    flex 1 1 200px
    width auto
    min-width 160px

  &__cell-prefix
    flex 0 0 120px
    width 120px
    font-family $prose_mono
    font-size 13px

  &__cell-date
    flex 0 0 180px
    width 180px

  &__cell-action
    flex 0 0 100px
    width 100px
    justify-content flex-end
