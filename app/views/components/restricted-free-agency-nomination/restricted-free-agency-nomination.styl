// Same card frame as the schedule it sits beside, with the status carried by
// the left border rather than a full-bleed tint — an outstanding obligation
// should read as urgent without shouting over the tables around it.
.restricted-free-agency-nomination
  display flex
  flex-direction column
  gap 10px
  padding 16px 20px
  background white
  border-radius 8px
  border-left 4px solid $borderColor
  height 100%

  &.rfa-nomination--due
    border-left-color rgb(237, 108, 2)

  &.rfa-nomination--set
    border-left-color rgb(46, 125, 50)

  .rfa-nomination__header
    display flex
    align-items flex-start
    justify-content space-between
    gap 16px

  .rfa-nomination__heading
    display flex
    flex-direction column
    gap 4px
    min-width 0

  .rfa-nomination__label
    font-family 'IBM Plex Mono', monospace
    letter-spacing .2em
    text-transform uppercase
    font-size 11px
    font-weight 800
    color rgba(0, 0, 0, 0.55)

  .rfa-nomination__headline
    font-size 16px
    font-weight 600

  .rfa-nomination__countdown
    flex 0 0 auto
    text-align right

  .rfa-nomination__countdown-value
    font-size 22px
    line-height 1.2
    font-weight 700
    font-variant-numeric tabular-nums

  .rfa-nomination__countdown-label
    font-size 10px
    text-transform uppercase
    letter-spacing 0.5px
    color rgba(0, 0, 0, 0.5)

  &.rfa-nomination--due .rfa-nomination__countdown-value
    color rgb(237, 108, 2)

  &.rfa-nomination--set .rfa-nomination__countdown-value
    color rgb(46, 125, 50)

  .rfa-nomination__nominee
    display flex
    align-items center

  .rfa-nomination__times
    display flex
    gap 28px
    padding-top 8px
    border-top 1px solid rgba(0, 0, 0, 0.08)

  .rfa-nomination__time-block
    display flex
    flex-direction column
    gap 1px

  .rfa-nomination__time-label
    font-size 10px
    color rgba(0, 0, 0, 0.5)
    text-transform uppercase
    letter-spacing 0.5px

  .rfa-nomination__time
    font-size 13px
    font-variant-numeric tabular-nums
    font-weight 500

  .rfa-nomination__instructions
    font-size 13px
    line-height 1.5
    color rgba(0, 0, 0, 0.6)

@media (max-width 600px)
  .restricted-free-agency-nomination
    padding 12px 14px

    .rfa-nomination__header
      flex-direction column
      gap 8px

    .rfa-nomination__countdown
      text-align left
