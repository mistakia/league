// Two steps and a readout, on one row. The pair reads as one control, so they
// share a row rather than each sitting on its own line in the controls strip.
.data-view-history
  display flex
  align-items center
  gap 6px
  align-self flex-start
  font 400 13px/1.4 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif

.data-view-history__step
  background white
  border 1px solid $borderColor
  border-radius $button_border_radius
  padding 4px 10px
  cursor pointer
  color $textColor
  font inherit
  font-weight 500
  transition border-color 120ms ease, color 120ms ease

  &:hover:not(:disabled)
    border-color $accentColor

  &:focus-visible
    outline 2px solid $accentColor
    outline-offset 2px

  // An end of the history is a real state and the control says so by going
  // quiet rather than by disappearing -- a button that vanishes at the newest
  // entry takes the position readout's neighbour with it and moves the row.
  // NOT $borderColorLight, which is `lighten($borderColor, 90)` and emits pure
  // white -- on a white button that is no border at all, so a disabled step
  // loses its box rather than going quiet and the row's geometry moves under
  // it. A translucent ink keeps the edge and lets the state read as dimmed.
  &:disabled
    cursor default
    color rgba(0, 0, 0, 0.32)
    border-color rgba(0, 0, 0, 0.09)

.data-view-history__position
  color rgba(0, 0, 0, 0.45)
  font-size 11px
  font-variant-numeric tabular-nums
