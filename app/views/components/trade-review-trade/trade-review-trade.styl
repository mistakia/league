// One accepted trade. The collapsed card in the list is a scoreboard — two
// sides, what each received, and what that has come to — and it opens the
// trade's own page, where the same scoreboard sits above the per-asset lineage.
.trade-review-trade
  background #fff
  border 1px solid #e0e0e0
  border-radius 8px
  margin-bottom 12px
  overflow hidden

  &.interactive .trade-review-trade__summary
    cursor pointer

    &:hover
      background #fafafa

    &:hover .trade-review-trade__open
      color #1565c0

    &:focus-visible
      outline 2px solid #1565c0
      outline-offset -2px

.trade-review-trade__summary
  padding 14px 16px

// The uppercase mono micro-label the rest of the app uses for a field caption.
// It has to read as a caption at a glance so the value beside it does not have
// to be qualified in prose.
.trade-review-trade__micro-label
  color rgba(0, 0, 0, 0.5)
  font-family 'IBM Plex Mono', monospace
  font-size 10px
  font-weight 800
  letter-spacing 0.16em
  text-transform uppercase

.trade-review-trade__summary-top
  align-items center
  display flex
  gap 10px
  margin-bottom 10px

.trade-review-trade__date
  color $textColor
  font-size 13px
  font-weight 600

// The shape of the deal — "2 for 1" — which is how an owner recalls a trade
// before he recalls any of the names in it.
.trade-review-trade__shape
  background #f2f2f2
  border-radius 10px
  color #616161
  font-size 11px
  font-variant-numeric tabular-nums
  padding 1px 8px

.trade-review-trade__open
  align-items center
  color #757575
  display flex
  font-size 12px
  gap 2px
  margin-left auto

  svg
    font-size 18px

.trade-review-trade__sides
  display flex
  flex-wrap wrap
  gap 12px

.trade-review-trade__side
  border 1px solid #eeeeee
  border-radius 6px
  display flex
  flex 1 1 260px
  flex-direction column
  gap 6px
  min-width 0
  padding 10px 12px

.trade-review-trade__side-team
  align-items center
  display flex
  flex-wrap wrap
  gap 6px

.trade-review-trade__side-assets
  display flex
  flex-direction column
  gap 2px

.trade-review-trade__side-asset
  align-items baseline
  display flex
  font-size 13px
  gap 8px
  justify-content space-between

.trade-review-trade__side-value
  color #757575
  font-size 12px
  font-variant-numeric tabular-nums

// The pair of totals is what makes the perspective structural rather than
// captioned: one net figure needs a sentence naming whose side it is written
// from, two side totals do not.
.trade-review-trade__side-totals
  border-top 1px solid #f0f0f0
  display flex
  gap 20px
  margin-top auto
  padding-top 6px

.trade-review-trade__total
  display flex
  flex-direction column
  gap 1px

.trade-review-trade__total-value
  font-size 15px
  font-variant-numeric tabular-nums
  font-weight 600

  &.up
    color #2e7d32

  &.down
    color #c62828

// Deliberately styled as prose rather than as a number: the absence has to read
// as "we do not know", not as a small or neutral value.
.trade-review-trade__unpriced
  color #9e9e9e
  cursor help
  font-size 12px
  font-style italic

.trade-review-trade__swing
  align-items center
  color #616161
  display flex
  flex-wrap wrap
  font-size 12px
  gap 4px
  margin-top 10px

  &.trade-review-trade__swing--unpriced
    color #9e9e9e
    cursor help
    font-style italic

.trade-review-trade__swing-value
  font-variant-numeric tabular-nums
  font-weight 600

.trade-review-trade__swing-team
  align-items center
  display flex
  gap 4px

.trade-review-trade__detail
  background #fcfcfc
  border-top 1px solid #e0e0e0
  display flex
  flex-wrap wrap
  gap 16px
  padding 14px 16px 16px

.trade-review-trade__perspective
  flex 1 1 380px
  min-width 0

.trade-review-trade__perspective-header
  align-items center
  border-bottom 1px solid #eeeeee
  display flex
  gap 8px
  padding-bottom 6px

.trade-review-trade__perspective-team
  align-items center
  display flex
  gap 6px

// What this side actually got out of the assets, in points and dollars, which
// is the question a market value cannot answer.
.trade-review-trade__production
  align-items baseline
  color #616161
  display flex
  flex-wrap wrap
  font-size 12px
  font-variant-numeric tabular-nums
  gap 10px
  padding 6px 0 0

.trade-review-trade__production-caption
  color #9e9e9e
  font-variant-numeric normal

.trade-review-trade__asset
  border-bottom 1px solid #f0f0f0
  padding 8px 0

  &:last-child
    border-bottom none

.trade-review-trade__asset-header
  align-items baseline
  display flex
  flex-wrap wrap
  gap 4px 12px
  justify-content space-between

.trade-review-trade__asset-name
  align-items center
  display flex
  font-weight 600
  gap 6px
  min-width 0

.trade-review-trade__asset-values
  align-items baseline
  color #616161
  display flex
  font-size 12px
  font-variant-numeric tabular-nums
  gap 6px

.trade-review-trade__asset-arrow
  color #bdbdbd

.trade-review-trade__lineage-state
  cursor help
  margin-left 6px

  &.no_longer_held
    color #9e9e9e

  &.held
    color #2e7d32

.trade-review-trade__resulting
  align-items center
  color #616161
  display flex
  flex-wrap wrap
  font-size 12px
  gap 4px 8px
  padding-top 4px

.trade-review-trade__chain
  border-left 2px solid #e6e6e6
  margin 6px 0 0 4px
  padding-left 10px

.trade-review-trade__chain-row
  display flex
  font-size 12px
  gap 10px
  padding 4px 0

  & + &
    border-top 1px dashed #f0f0f0

// The date leads every hop, because a lineage read without one is a list of
// events in no particular time.
.trade-review-trade__chain-when
  color #9e9e9e
  flex 0 0 88px
  font-variant-numeric tabular-nums

.trade-review-trade__chain-body
  display flex
  flex-direction column
  gap 2px
  min-width 0

.trade-review-trade__chain-headline
  align-items baseline
  display flex
  flex-wrap wrap
  gap 2px 8px

.trade-review-trade__chain-event
  color #424242

  a
    color #1565c0

    &:hover
      text-decoration underline

.trade-review-trade__chain-asset
  align-items center
  display flex
  gap 4px
  min-width 0

.trade-review-trade__chain-team
  align-items center
  display flex
  gap 4px

.trade-review-trade__chain-outcome
  color #757575

.trade-review-trade__chain-stats
  color #9e9e9e
  display flex
  flex-wrap wrap
  font-variant-numeric tabular-nums
  gap 10px

// The named state an asset with no lineage rows renders as. A blank here would
// be indistinguishable from an asset that produced nothing.
.trade-review-trade__chain-absent
  color #ef6c00
  font-size 12px
  padding 4px 0 0 8px

// The line shown while an expanded trade's per-asset lineage chains are still
// being fetched. The scoreboard above it renders immediately from the list
// response, so this marks the one part of the detail that is still arriving
// rather than replacing the whole detail with a spinner. The spinner is small
// on purpose: the loading belongs to this card, not the page.
.trade-review-trade__chains-loading
  align-items center
  color #9e9e9e
  display flex
  font-size 12px
  gap 6px
  padding 4px 0 0 2px
  width 100%

.trade-review-trade__chains-loading-spinner
  animation chains-loading-spin 0.9s linear infinite
  border 2px solid rgba(25, 118, 210, 0.2)
  border-top-color #1976d2
  border-radius 50%
  height 12px
  width 12px

@keyframes chains-loading-spin
  to
    transform rotate(360deg)

// Narrow widths stack the two sides and drop the date out of its own column, so
// a hop reads as two lines rather than as a wrapped five-column row.
@media (max-width 599px)
  .trade-review-trade__summary
    padding 12px

  .trade-review-trade__open span
    display none

  .trade-review-trade__chain-row
    flex-direction column
    gap 2px

  .trade-review-trade__chain-when
    flex 0 0 auto
