// One accepted trade. The collapsed card in the list is a scoreboard — two
// sides, what each received, and what that has come to — and it opens the
// trade's own page, where the same scoreboard sits above the per-asset lineage.
.trade-review-trade
  background #fff
  border 1px solid #e0e0e0
  border-radius 8px
  margin-bottom 12px
  overflow hidden

  &.interactive .trade-review-trade__summary
    cursor pointer

    &:hover
      background #fafafa

    &:hover .trade-review-trade__open
      color #1565c0

    &:focus-visible
      outline 2px solid #1565c0
      outline-offset -2px

.trade-review-trade__summary
  padding 14px 16px

// The uppercase mono micro-label the rest of the app uses for a field caption.
// It has to read as a caption at a glance so the value beside it does not have
// to be qualified in prose.
.trade-review-trade__micro-label
  color rgba(0, 0, 0, 0.5)
  font-family 'IBM Plex Mono', monospace
  font-size 10px
  font-weight 800
  letter-spacing 0.16em
  text-transform uppercase
  white-space nowrap

.trade-review-trade__summary-top
  align-items center
  display flex
  flex-wrap wrap
  gap 8px 12px
  margin-bottom 12px

.trade-review-trade__date
  color $textColor
  font-size 14px
  font-weight 600

// The shape of the deal — "2 for 1" — which is how an owner recalls a trade
// before he recalls any of the names in it.
.trade-review-trade__shape
  background #f2f2f2
  border-radius 10px
  color #616161
  font-size 11px
  font-variant-numeric tabular-nums
  padding 1px 8px

.trade-review-trade__open
  align-items center
  color #757575
  display flex
  font-size 12px
  gap 2px
  margin-left auto

  svg
    font-size 18px

.trade-review-trade__sides
  display flex
  flex-wrap wrap
  gap 12px

.trade-review-trade__side
  border 1px solid #eeeeee
  border-radius 6px
  display flex
  flex 1 1 280px
  flex-direction column
  gap 8px
  min-width 0
  padding 10px 12px

.trade-review-trade__side-team
  align-items center
  display flex
  flex-wrap wrap
  gap 6px

.trade-review-trade__side-assets
  display flex
  flex-direction column
  gap 6px

// The traded assets are the subject of the card, so they carry the largest type
// on it. A headshot makes a name identifiable before it is read.
.trade-review-trade__side-asset
  align-items center
  display flex
  font-size 15px
  gap 10px
  justify-content space-between
  min-height 32px

.trade-review-trade__side-value
  color #616161
  flex 0 0 auto
  font-size 13px
  font-variant-numeric tabular-nums

// PlayerName renders a fragment of two siblings — the name and its status
// chips — so each one needs its own flex wrapper or the chips wrap onto a line
// of their own. The flex on .player__name is overridden for the same reason:
// left alone it expands to fill the row and pushes the value away.
.trade-review-trade__player
  align-items center
  display inline-flex
  gap 4px
  min-width 0

  .player__name
    flex 0 1 auto
    min-width 0

  .player__name-label
    flex 0 0 auto

.trade-review-trade__pick
  display flex
  flex-direction column
  line-height 1.25
  min-width 0

.trade-review-trade__pick-main
  font-weight 500

.trade-review-trade__pick-meta
  color #9e9e9e
  font-size 11px

// Every figure on a side belongs to that side alone, which is what lets both
// columns read green at once. A single net figure could not: it needs a
// sentence naming whose view it is written from, and it forces one winner.
.trade-review-trade__side-totals
  border-top 1px solid #f0f0f0
  display flex
  gap 20px
  margin-top auto
  padding-top 8px

.trade-review-trade__stat
  display flex
  flex-direction column
  gap 1px
  min-width 0

.trade-review-trade__stat-value
  font-size 16px
  font-variant-numeric tabular-nums
  font-weight 600

  &.up
    color #2e7d32

  &.down
    color #c62828

// What the assets DID, as against what they were worth. Beneath the market
// figures because it answers a different question, not a lesser one.
.trade-review-trade__production
  display flex
  flex-wrap wrap
  font-size 12px
  gap 2px 8px

// The trade as a whole, which is the reading the two side columns cannot give:
// a deal can grow or shrink the value both rosters hold together.
.trade-review-trade__combined
  align-items center
  border-top 1px solid #f0f0f0
  cursor help
  display flex
  flex-wrap wrap
  gap 8px
  margin-top 12px
  padding-top 10px

.trade-review-trade__combined-flow
  align-items center
  display flex
  font-size 14px
  font-variant-numeric tabular-nums
  gap 6px

.trade-review-trade__combined-change
  font-size 14px
  font-variant-numeric tabular-nums
  font-weight 600

  &.up
    color #2e7d32

  &.down
    color #c62828

.trade-review-trade__combined-production
  font-size 12px

// Deliberately styled as prose rather than as a number: the absence has to read
// as "we do not know", not as a small or neutral value.
.trade-review-trade__unpriced
  color #9e9e9e
  cursor help
  font-size 12px
  font-style italic

.trade-review-trade__detail
  background #fcfcfc
  border-top 1px solid #e0e0e0
  display flex
  flex-wrap wrap
  gap 20px
  padding 16px

.trade-review-trade__perspective
  flex 1 1 400px
  min-width 0

.trade-review-trade__perspective-header
  align-items center
  border-bottom 1px solid #e6e6e6
  display flex
  flex-wrap wrap
  gap 8px
  padding-bottom 8px

.trade-review-trade__perspective-team
  align-items center
  display flex
  gap 6px

.trade-review-trade__asset
  border-bottom 1px solid #ececec
  padding 12px 0

  &:last-child
    border-bottom none

.trade-review-trade__asset-header
  align-items center
  display flex
  flex-wrap wrap
  gap 6px 12px
  justify-content space-between

.trade-review-trade__asset-name
  align-items center
  display flex
  font-size 15px
  font-weight 600
  gap 6px
  min-width 0

.trade-review-trade__asset-values
  align-items baseline
  color #616161
  display flex
  font-size 13px
  font-variant-numeric tabular-nums
  gap 6px

.trade-review-trade__asset-arrow
  color #bdbdbd

.trade-review-trade__lineage-state
  cursor help
  font-size 12px
  margin-left 6px

  &.no_longer_held
    color #9e9e9e

  &.held
    color #2e7d32

// The lineage, as a dated timeline rather than a table. Each step is one
// holding: when it began, who held it, and how it came about. The rail and its
// dots are what make a chain read as a single path at a glance.
.trade-review-trade__chain
  margin 8px 0 0 4px

.trade-review-trade__step
  display flex
  gap 10px
  position relative

.trade-review-trade__step-marker
  flex 0 0 9px
  position relative

  &::before
    background #fff
    border 2px solid #bdbdbd
    border-radius 50%
    content ''
    height 9px
    left 0
    position absolute
    top 5px
    width 9px
    z-index 1

  &::after
    background #e6e6e6
    bottom 0
    content ''
    left 4px
    position absolute
    top 14px
    width 1px

.trade-review-trade__step.last .trade-review-trade__step-marker::after
  display none

.trade-review-trade__step.open .trade-review-trade__step-marker::before
  background #2e7d32
  border-color #2e7d32

.trade-review-trade__step-content
  display flex
  flex-direction column
  gap 2px
  min-width 0
  padding-bottom 12px

.trade-review-trade__step-headline
  align-items baseline
  display flex
  flex-wrap wrap
  gap 2px 8px

.trade-review-trade__step-date
  color #9e9e9e
  flex 0 0 auto
  font-size 12px
  font-variant-numeric tabular-nums

.trade-review-trade__step-team
  align-items center
  display flex
  gap 4px

.trade-review-trade__step-event
  color #424242
  font-size 13px

  a
    color #1565c0

    &:hover
      text-decoration underline

// The asset is named only where it CHANGES — a pick that became a player —
// because repeating one name down every step of a chain is what made the old
// layout read as a wall.
.trade-review-trade__step-asset
  align-items center
  display flex
  font-size 13px
  gap 6px
  min-width 0

.trade-review-trade__step-stats
  display flex
  flex-wrap wrap
  font-size 12px
  gap 2px 8px

.trade-review-trade__step-idle
  color #9e9e9e
  font-style italic

// A figure and the noun it counts, always in that order and always together.
// The number carries the weight and the noun stays muted, which is what lets a
// row of these be scanned without reading every word of it.
.trade-review-trade__stat-chip
  align-items baseline
  cursor help
  display inline-flex
  gap 3px

  & + &::before
    color #d5d5d5
    content '·'
    margin-right 5px

.trade-review-trade__stat-chip-value
  color $textColor
  font-variant-numeric tabular-nums
  font-weight 600

.trade-review-trade__stat-chip-label
  color #9e9e9e

.trade-review-trade__step-end
  color #616161
  font-size 12px
  font-weight 500

// The named state an asset with no lineage rows renders as. A blank here would
// be indistinguishable from an asset that produced nothing.
.trade-review-trade__chain-absent
  color #ef6c00
  font-size 12px
  padding 4px 0 0 8px

// The line shown while an expanded trade's per-asset lineage chains are still
// being fetched. The scoreboard above it renders immediately from the list
// response, so this marks the one part of the detail that is still arriving
// rather than replacing the whole detail with a spinner. The spinner is small
// on purpose: the loading belongs to this card, not the page.
.trade-review-trade__chains-loading
  align-items center
  color #9e9e9e
  display flex
  font-size 12px
  gap 6px
  padding 4px 0 0 2px
  width 100%

.trade-review-trade__chains-loading-spinner
  animation chains-loading-spin 0.9s linear infinite
  border 2px solid rgba(25, 118, 210, 0.2)
  border-top-color #1976d2
  border-radius 50%
  height 12px
  width 12px

@keyframes chains-loading-spin
  to
    transform rotate(360deg)

@media (max-width 599px)
  .trade-review-trade__summary
    padding 12px

  .trade-review-trade__open span
    display none

  .trade-review-trade__side-totals
    gap 14px

  .trade-review-trade__stat-value
    font-size 15px
