.restricted-free-agency-schedule
  display flex
  flex-direction column
  gap 8px
  padding 12px

  .rfa-schedule__title
    font-size 15px
    font-weight 600

  .rfa-schedule__summary
    font-size 13px
    line-height 1.5
    color rgba(0, 0, 0, 0.6)

  // Active window — full detail row
  .rfa-schedule__current
    display flex
    align-items center
    gap 12px
    padding 10px 12px
    border-radius 6px
    background rgba(25, 118, 210, 0.08)

  .rfa-schedule__current-label
    text-transform uppercase
    font-size 10px
    letter-spacing 0.8px
    color rgba(0, 0, 0, 0.55)
    font-weight 600

  .rfa-schedule__current-body
    display flex
    align-items center
    gap 16px
    flex 1

  .rfa-schedule__current-team
    display flex
    align-items center
    gap 6px
    font-weight 500
    font-size 13px

  .rfa-schedule__current-tag
    font-size 11px
    color rgba(25, 118, 210, 0.8)
    font-weight 500

  .rfa-schedule__current-times
    display flex
    align-items center
    gap 6px
    margin-left auto

  .rfa-schedule__current-time-label
    font-size 11px
    color rgba(0, 0, 0, 0.5)
    text-transform uppercase
    letter-spacing 0.3px

  .rfa-schedule__current-time
    font-size 13px
    font-variant-numeric tabular-nums
    font-weight 500

  .rfa-schedule__countdown
    font-size 13px
    font-variant-numeric tabular-nums
    font-weight 600
    color rgba(25, 118, 210, 1)
    padding 2px 6px
    border-radius 4px
    background rgba(25, 118, 210, 0.12)
    min-width 92px
    text-align center

  // Future windows — condensed timeline
  .rfa-schedule__future
    display flex
    flex-direction column
    gap 2px

  .rfa-schedule__future-header
    display flex
    align-items center
    justify-content space-between
    margin-bottom 4px

  .rfa-schedule__future-title
    font-size 11px
    text-transform uppercase
    letter-spacing 0.5px
    color rgba(0, 0, 0, 0.5)
    font-weight 600

  .rfa-schedule__toggle
    font-size 12px
    color rgba(25, 118, 210, 0.85)
    background none
    border none
    cursor pointer
    padding 2px 0
    font-weight 500

    &:hover
      color rgba(25, 118, 210, 1)
      text-decoration underline

  .rfa-schedule__future-row
    display flex
    align-items center
    padding 5px 4px
    border-radius 3px
    font-size 13px

    &:hover
      background rgba(0, 0, 0, 0.03)

    &--warning
      background rgba(255, 152, 0, 0.06)

    &--mine
      font-weight 600

  .rfa-schedule__future-team
    flex 1
    display flex
    align-items center
    gap 6px

  .rfa-schedule__future-tag
    font-size 11px
    color rgba(25, 118, 210, 0.8)
    font-weight 500

  .rfa-schedule__future-time
    font-variant-numeric tabular-nums
    color rgba(0, 0, 0, 0.7)
    min-width 120px
    text-align right
