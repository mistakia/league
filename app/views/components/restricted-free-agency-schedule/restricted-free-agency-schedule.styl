// Card-framed to match the other league-home sections; the grid cell owns the
// width. Unbounded and stretched, the current-window row put its team name and
// its times at opposite edges of a 1900px screen with nothing between them.
.restricted-free-agency-schedule
  display flex
  flex-direction column
  gap 10px
  padding 16px 20px
  background white
  border-radius 8px
  height 100%

  .rfa-schedule__title
    font-family 'IBM Plex Mono', monospace
    letter-spacing .2em
    text-transform uppercase
    font-size 12px
    font-weight 800

  .rfa-schedule__summary
    font-size 13px
    line-height 1.5
    color rgba(0, 0, 0, 0.6)

  // Active window — team and countdown on one line, the two boundaries as
  // natural-width blocks beneath, so nothing stretches to fill the card
  .rfa-schedule__current
    display flex
    flex-direction column
    padding 12px 14px
    border 1px solid $borderColor
    border-radius 6px
    background rgba(25, 118, 210, 0.06)

  .rfa-schedule__current-header
    display flex
    align-items flex-start
    justify-content space-between
    gap 16px

  .rfa-schedule__current-heading
    display flex
    flex-direction column
    gap 4px
    min-width 0

  .rfa-schedule__current-label
    text-transform uppercase
    font-size 10px
    letter-spacing 0.8px
    color rgba(0, 0, 0, 0.55)
    font-weight 600

  .rfa-schedule__current-team
    display flex
    align-items center
    gap 6px
    font-weight 500
    font-size 14px

  .rfa-schedule__current-tag
    font-size 11px
    color rgba(25, 118, 210, 0.8)
    font-weight 500

  .rfa-schedule__current-times
    display flex
    gap 28px
    margin-top 10px
    padding-top 8px
    border-top 1px solid rgba(0, 0, 0, 0.08)

  .rfa-schedule__current-time-block
    display flex
    flex-direction column
    gap 1px

  .rfa-schedule__current-time-label
    font-size 10px
    color rgba(0, 0, 0, 0.5)
    text-transform uppercase
    letter-spacing 0.5px

  .rfa-schedule__current-time
    font-size 13px
    font-variant-numeric tabular-nums
    font-weight 500

  .rfa-schedule__countdown
    flex 0 0 auto
    text-align right

  .rfa-schedule__countdown-value
    font-size 22px
    line-height 1.2
    font-weight 700
    font-variant-numeric tabular-nums
    color rgba(25, 118, 210, 1)

  .rfa-schedule__countdown-label
    font-size 10px
    text-transform uppercase
    letter-spacing 0.5px
    color rgba(0, 0, 0, 0.5)

  // Future windows — condensed timeline
  .rfa-schedule__future
    display flex
    flex-direction column
    gap 2px

  .rfa-schedule__future-header
    display flex
    align-items center
    justify-content space-between
    margin-bottom 4px

  .rfa-schedule__future-title
    font-size 11px
    text-transform uppercase
    letter-spacing 0.5px
    color rgba(0, 0, 0, 0.5)
    font-weight 600

  .rfa-schedule__toggle
    font-size 12px
    color rgba(25, 118, 210, 0.85)
    background none
    border none
    cursor pointer
    padding 2px 0
    font-weight 500

    &:hover
      color rgba(25, 118, 210, 1)
      text-decoration underline

  .rfa-schedule__future-row
    display flex
    align-items center
    padding 5px 4px
    border-radius 3px
    font-size 13px

    &:hover
      background rgba(0, 0, 0, 0.03)

    &--warning
      background rgba(255, 152, 0, 0.06)

    &--mine
      font-weight 600

  .rfa-schedule__future-team
    flex 1
    min-width 0
    display flex
    align-items center
    gap 6px

  .rfa-schedule__future-tag
    font-size 11px
    color rgba(25, 118, 210, 0.8)
    font-weight 500

  .rfa-schedule__future-time
    font-variant-numeric tabular-nums
    color rgba(0, 0, 0, 0.7)
    min-width 120px
    text-align right

@media (max-width 600px)
  .restricted-free-agency-schedule
    padding 12px

    .rfa-schedule__current-header
      flex-direction column
      gap 8px

    .rfa-schedule__countdown
      text-align left

    .rfa-schedule__future-time
      min-width 0
