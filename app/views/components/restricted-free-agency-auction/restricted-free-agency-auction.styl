.restricted-free-agency-auction
  background #fff
  border 1px solid #e0e0e0
  border-radius 8px
  margin-bottom 12px
  overflow hidden

.restricted-free-agency-auction__header
  align-items center
  border-bottom 1px solid #e0e0e0
  display flex
  flex-wrap wrap
  gap 8px 24px
  justify-content space-between
  padding 10px 16px

// PlayerName renders a fragment whose second element carries the status and tag
// labels. In a block parent that element starts its own line, so a tagged
// player put his PUP/Q chip on a row of its own under the position badge.
.restricted-free-agency-auction__player
  align-items center
  display flex
  font-weight 600
  gap 6px
  min-width 0

  .player__name
    flex 0 1 auto

  .player__name-label
    flex 0 0 auto

.restricted-free-agency-auction__meta
  align-items center
  color #616161
  display flex
  flex-wrap wrap
  font-size 12px
  gap 6px 20px
  justify-content flex-end

// Each fact is one unbreakable unit: 'Signed by <team> $27' wrapped mid-phrase
// on desktop because the whole meta block was a single wrapping flex line.
.restricted-free-agency-auction__meta-item
  align-items center
  display flex
  gap 6px
  white-space nowrap

.restricted-free-agency-auction__meta-label
  color #9e9e9e
  font-size 10px
  letter-spacing 0.06em
  text-transform uppercase

.restricted-free-agency-auction__meta-amount
  color #212121
  font-variant-numeric tabular-nums
  font-weight 600

.restricted-free-agency-auction__date
  color #9e9e9e
  white-space nowrap

// Four fixed columns rather than a flex row: the bids of one auction then share
// a single alignment, and the releases column absorbs the leftover width that
// used to sit dead in the middle of the card.
.restricted-free-agency-auction__bid
  align-items center
  border-bottom 1px solid #f5f5f5
  column-gap 12px
  display grid
  // The outcome column is sized for the widest chip in the vocabulary,
  // 'Exceeded Roster Limits' at 155px: the chip is nowrap, so a narrower column
  // does not clip it, it overlaps the releases beside it.
  grid-template-columns minmax(160px, 1.3fr) 64px 160px minmax(0, 1.5fr)
  padding 6px 16px

  &:last-child
    border-bottom none

  &.winner
    background #f1f8e9

.restricted-free-agency-auction__bid-team
  align-items center
  display flex
  gap 8px
  min-width 0

.restricted-free-agency-auction__original-team
  background #eeeeee
  border-radius 2px
  color #616161
  flex 0 0 auto
  font-size 10px
  letter-spacing 0.04em
  padding 1px 5px
  text-transform uppercase

.restricted-free-agency-auction__bid-amount
  font-variant-numeric tabular-nums
  font-weight 600
  text-align right

.restricted-free-agency-auction__bid-outcome
  display flex

.restricted-free-agency-auction__outcome
  border-radius 10px
  font-size 10px
  font-weight 600
  letter-spacing 0.04em
  padding 2px 8px
  text-transform uppercase
  white-space nowrap

  &.won
    background #c8e6c9
    color #1b5e20

  &.matched
    background #e1bee7
    color #4a148c

  &.outbid
    background #ffe0b2
    color #e65100

  &.lost_tiebreak
    background #ffecb3
    color #ff6f00

  &.roster_limit_violation, &.player_ineligible, &.processing_error
    background #ffcdd2
    color #b71c1c

// Releases run across the row. `.player__name` carries `flex 1`, so without the
// override below a bid with six releases stacked them one per line.
.restricted-free-agency-auction__releases
  align-items center
  color #757575
  column-gap 12px
  display flex
  flex-wrap wrap
  font-size 12px
  min-width 0
  row-gap 2px

.restricted-free-agency-auction__release
  align-items center
  display flex
  flex 0 0 auto

  .player__name, .player__name-label
    flex 0 0 auto

.restricted-free-agency-auction__releases-label
  color #9e9e9e
  font-size 10px
  letter-spacing 0.06em
  text-transform uppercase

@media (max-width 599px)
  .restricted-free-agency-auction__meta
    justify-content flex-start

  // Team and amount pair on the first line, the outcome chip drops below, and
  // releases take a full-width line of their own.
  .restricted-free-agency-auction__bid
    column-gap 8px
    grid-template-columns minmax(0, 1fr) auto
    padding 8px 12px
    row-gap 4px

  .restricted-free-agency-auction__releases
    grid-column 1 / -1
