.restricted-free-agency-auction
  background #fff
  border 1px solid #e0e0e0
  border-radius 4px
  margin-bottom 16px
  overflow hidden

.restricted-free-agency-auction__header
  align-items center
  border-bottom 1px solid #e0e0e0
  display flex
  flex-wrap wrap
  justify-content space-between
  padding 12px 16px

.restricted-free-agency-auction__player
  font-weight 600

.restricted-free-agency-auction__meta
  align-items center
  color #616161
  display flex
  flex-wrap wrap
  font-size 12px
  gap 16px

.restricted-free-agency-auction__date
  color #9e9e9e

.restricted-free-agency-auction__bid
  align-items center
  border-bottom 1px solid #f5f5f5
  display flex
  flex-wrap wrap
  gap 12px
  padding 8px 16px

  &:last-child
    border-bottom none

  &.winner
    background #f1f8e9

.restricted-free-agency-auction__bid-team
  align-items center
  display flex
  gap 8px
  min-width 180px

.restricted-free-agency-auction__original-team
  background #eeeeee
  border-radius 2px
  color #616161
  font-size 10px
  padding 1px 5px
  text-transform uppercase

.restricted-free-agency-auction__bid-amount
  font-variant-numeric tabular-nums
  font-weight 600
  min-width 60px

.restricted-free-agency-auction__outcome
  border-radius 2px
  font-size 11px
  padding 2px 8px
  text-transform uppercase
  white-space nowrap

  &.won
    background #c8e6c9
    color #1b5e20

  &.matched
    background #e1bee7
    color #4a148c

  &.outbid
    background #ffe0b2
    color #e65100

  &.lost_tiebreak
    background #ffecb3
    color #ff6f00

  &.roster_limit_violation, &.player_ineligible, &.processing_error
    background #ffcdd2
    color #b71c1c

.restricted-free-agency-auction__releases
  color #757575
  font-size 12px
