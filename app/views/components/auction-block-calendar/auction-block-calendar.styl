// EVERY COLOUR IN THIS FILE WAS INERT UNTIL 2026-09-02. The grid was written
// against `var(--table-border)`, `var(--table-row-alt)`, `var(--primary)` and
// `var(--text)` -- four custom properties declared nowhere in this repo, so
// each var() was invalid at computed-value time and the whole declaration was
// dropped. Measured on the running page: a cell's computed backgroundColor was
// `rgba(0, 0, 0, 0)`, both borders were absent, and the convened, mine and
// selected states were indistinguishable from an empty cell. The calendar
// rendered as 168 invisible boxes against white, which is what "the schedule
// does not show the selectable days and blocks" was. Use the stylus tokens in
// app/styles/variables.styl, which are injected into every stylesheet by
// stylus-loader; a custom property here has to be DECLARED somewhere before it
// means anything.
// lighten() on these tokens is the trap this file just came out of: $borderColor
// is already at 82% lightness and $accentColor at 50%, so lighten(x, 55%) and
// lighten(x, 60%) both clamp to pure WHITE -- invisible against the panel, the
// exact symptom being fixed. mix() against white is the form that keeps a tint.
$grid_open_fill = #ececec

// THE CELL'S CONTENT IS THE NUMBER, and every line drawn on the cell competes
// with it. The grid used a full-strength $borderColor rule every six columns
// and full-strength accent and text rings for `mine` and `selected`, which in a
// ten-pixel cell put a hard edge within a pixel of a 9px numeral on all four
// sides -- so the count, the only quantity on the grid, was the least legible
// thing on it. Every line here is now a wash of its former colour and the
// numeral is larger and darker than any of them.
// Checked against the EMITTED css, not the source: at 40% this resolves to
// #ececec, which is exactly $grid_open_fill, so the six-hour rule and every key
// swatch border disappeared entirely. Reducing a line to nothing is not
// reducing it.
$grid_rule = mix($borderColor, white, 70%)
$grid_selected_ring = mix($textColorDark, white, 55%)

// `OURS` IS A MARK, NOT A RING. A ring is the one shape that cannot be made to
// stop competing with the numeral, because it surrounds it: paling the colour
// only trades a hard edge beside an 11px digit for a soft one, and at the width
// of a cell in the side rail there is no ring inset that clears the glyph. The
// mark instead takes the strip of cell the numeral does not use -- the numeral
// is pushed up by the cell's bottom padding and the dot sits under it, touching
// nothing.
//
// It also COMPOSES, which the ring only accidentally did. `finalized` and
// `final-block` are backgrounds and would have swallowed a fill-based `mine`
// outright; a pseudo-element sits on top of whatever ground the cell has, so an
// hour that is both convened and yours still says so. `now` owns ::after for
// the same reason, which is why this one is ::before.
$grid_mine_mark = $accentColor
$grid_mine_mark_size = 4px

.auction__block-calendar
  display flex
  flex-direction column
  padding 8px
  border-bottom 1px solid $borderColor

.auction__block-calendar-header
  display flex
  justify-content space-between
  align-items baseline
  gap 8px
  flex 1
  min-width 0
  flex-wrap wrap

.auction__block-calendar-title
  font-weight 600
  text-transform uppercase
  font-size 11px
  letter-spacing 0.5px

.auction__block-calendar-final
  display flex
  gap 6px
  align-items baseline
  font-size 11px
  opacity 0.85

.auction__block-calendar-legend
  font-size 11px
  line-height 1.5
  color $textColor
  padding 4px 0 8px

.auction__block-calendar-grid
  display flex
  flex-direction column
  gap 2px

.auction__block-calendar-row
  display flex
  gap 1px
  align-items center

.auction__block-calendar-day
  width 46px
  flex none
  font-size 11px
  font-weight 600
  color $textColor

// The hour axis, so a column can be read without hovering it.
.auction__block-calendar-axis
  padding-bottom 2px

.auction__block-calendar-hour-label
  flex 1 1 0
  min-width 10px
  font-size 9px
  line-height 1
  color mix($textColor, white, 70%)
  text-align left
  white-space nowrap
  overflow visible

.auction__block-calendar-cell
  position relative
  flex 1 1 0
  min-width 10px
  height 24px
  // The bottom strip belongs to the `mine` mark, so the numeral is centred in
  // what is left rather than in the whole cell. Reserved unconditionally: a
  // padding that appeared only on `mine` cells would move the digit whenever a
  // manager opted in, which reads as the grid twitching under the click.
  padding-bottom 6px
  display flex
  align-items center
  justify-content center
  font-size 11px
  font-weight 600
  line-height 1
  color $textColorDark
  cursor default
  background transparent
  box-sizing border-box

  // A six-hour rule, matching the axis labels, so the unlabelled columns
  // between them are still countable from a labelled one. Washed out, because
  // it lands directly against the numeral of the cell it opens.
  &:nth-child(6n + 2)
    border-left 1px solid $grid_rule

  // Inside the period and outside the notice threshold: this is what a manager
  // can actually act on, so it is the only state that reads as a control.
  &.selectable
    background $grid_open_fill
    cursor pointer

    // Neutral rather than accent-tinted: an accent hover at any strength that
    // reads as a hover is indistinguishable from `has-opt-ins`, which is the
    // one state on this grid a manager acts on.
    &:hover
      background darken($grid_open_fill, 10%)

  // In the period but already inside the notice window. It cannot convene, so
  // it must not look like an open hour.
  &.too-soon
    background repeating-linear-gradient(45deg, #f4f4f4, #f4f4f4 2px, #e4e4e4 2px, #e4e4e4 4px)

  &.outside
    background transparent
    opacity 0.25

  // Somebody wants this hour. The number in the cell is how many, so the fill
  // stays a pale wash and the numeral carries the full-strength colour.
  &.has-opt-ins
    background mix($accentColor, white, 16%)
    color darken($accentColor, 25%)

  // MINE AND SELECTED USE DIFFERENT MECHANISMS ON PURPOSE. Both were
  // `box-shadow`, so the later rule silently won and a selected hour stopped
  // showing that it was also yours. `outline` composites independently of
  // `box-shadow`, and `outline-offset` keeps it inside the cell rather than
  // over the neighbour.
  // Yours: a dot in the strip under the numeral. Centred rather than cornered
  // because a cell is about eleven pixels wide in the side rail, so a corner
  // mark and a centred digit overlap horizontally at every count.
  &.mine::before
    content ''
    position absolute
    left 50%
    bottom 2px
    margin-left -($grid_mine_mark_size / 2)
    width $grid_mine_mark_size
    height $grid_mine_mark_size
    border-radius 50%
    background $grid_mine_mark

  // `outline` rather than a border or a box-shadow: it takes no space, so it
  // cannot shift the numeral, and `outline-offset` keeps it inside the cell
  // rather than over the neighbour.
  &.selected
    outline 1px solid $grid_selected_ring
    outline-offset -1px

  // These two keep their full-strength fills. Everything else on the cell was
  // washed out to let the numeral through, and washing these does the opposite:
  // the numeral on them is WHITE, so a paler ground is less legible, not more.
  &.finalized
    background $successColor
    color white

  &.final-block
    background #c0392b
    color white

  // The mark inverts on the two dark grounds, exactly as the numeral does. An
  // accent dot on `final-block` is red on red, which is the state it composes
  // with most often: the final block convenes by rule, so an hour is routinely
  // both the final block and one a manager opted into elsewhere in the hour.
  &.finalized.mine::before,
  &.final-block.mine::before
    background white

  // The current hour, as a bar rather than a border: a border on one side of
  // the cell shifts the numeral it sits above.
  &.now::after
    content ''
    position absolute
    left 0
    right 0
    top 0
    height 2px
    background $accentColor

// The key. The grid is six states in ten-pixel cells, which no amount of
// colour choice makes self-evident.
.auction__block-calendar-key
  display flex
  flex-wrap wrap
  gap 4px 10px
  padding 8px 0 0
  font-size 10px
  color $textColor

  span
    display flex
    align-items center
    gap 4px

.auction__block-calendar-swatch
  position relative
  width 10px
  height 10px
  flex none
  display inline-block
  border 1px solid $grid_rule
  box-sizing border-box

  &.selectable
    background $grid_open_fill

  &.has-opt-ins
    background mix($accentColor, white, 16%)

  // The `mine` swatch carries the MARK, on the opted-in ground it appears
  // against. A swatch showing the ring the grid no longer draws is a key to a
  // state the grid does not have.
  &.mine
    background mix($accentColor, white, 16%)

    &::before
      content ''
      position absolute
      left 50%
      top 50%
      // Two longhands, not a four-value `margin`. Stylus reads the `0 0 -(x)`
      // run in a shorthand as arithmetic and emits `0 - 2px`, so the four
      // values collapse to three and the mark lands off-centre.
      margin-top -($grid_mine_mark_size / 2)
      margin-left -($grid_mine_mark_size / 2)
      width $grid_mine_mark_size
      height $grid_mine_mark_size
      border-radius 50%
      background $grid_mine_mark

  &.finalized
    background $successColor

  &.final-block
    background #c0392b

  &.too-soon
    background repeating-linear-gradient(45deg, #f4f4f4, #f4f4f4 2px, #e4e4e4 2px, #e4e4e4 4px)

.auction__block-calendar-detail
  padding 8px 0 0
  border-top 1px solid $borderColor
  margin-top 8px

.auction__block-calendar-detail-head
  display flex
  align-items center
  justify-content space-between
  gap 8px
  flex-wrap wrap
  font-size 12px
  font-weight 600
  padding-bottom 6px

.auction__block-calendar-slot
  display flex
  align-items center
  gap 8px
  padding 6px 0
  // A rule per slot rather than a block of four undifferentiated rows. It also
  // separates the first slot from the head above it, which carries the
  // hour-wide button -- no `:first-of-type` exemption, because the head is a
  // div too and the pseudo-class would match IT rather than any slot.
  border-top 1px solid mix($borderColor, white, 50%)

  // The manager's own slots, so the four rows are scannable without reading
  // every team chip: the hour-wide button acts on whichever of them are still
  // open, and which those are has to be visible before pressing it.
  &.mine
    .auction__block-calendar-slot-time
      color darken($accentColor, 25%)
      font-weight 600

.auction__block-calendar-slot-time
  width 72px
  flex none
  font-size 12px

.auction__block-calendar-slot-teams
  flex 1 1 auto
  display flex
  flex-wrap wrap
  gap 4px
  font-size 11px

.auction__block-calendar-slot-action
  flex none

.auction__block-calendar-empty,
.auction__block-calendar-lapsed
  opacity 0.5
  font-size 11px

.auction__block-calendar-convened
  color $successColor
  font-weight 600
  font-size 11px

// A phone gets a taller cell, because the target is a finger rather than a
// cursor and the rail is the full page width there rather than 320px.
@media (max-width 800px)
  .auction__block-calendar-cell
    height 28px

// Same as the standing-elections panel: when collapsible the root is the
// Accordion and its summary button owns the padding.
.accordion.auction__block-calendar
  padding 0
  border-bottom 1px solid $borderColor

  .auction__block-calendar-legend
    padding-top 0
