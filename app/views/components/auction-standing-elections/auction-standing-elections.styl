.auction-standing-elections
  padding 12px
  display flex
  flex-direction column
  gap 12px

  &__header
    display flex
    justify-content space-between
    align-items baseline

    h3
      margin 0
      font-size 14px

  &__group
    display flex
    flex-direction column
    gap 4px

    label
      font-size 11px
      text-transform uppercase
      opacity 0.6

  &__row
    display flex
    justify-content space-between
    align-items center
    gap 8px
    font-size 13px

  &__capped
    opacity 0.7
    font-style italic

  &__outcome
    font-size 11px
    text-transform uppercase
    opacity 0.7

  &__empty
    font-size 13px
    opacity 0.7
