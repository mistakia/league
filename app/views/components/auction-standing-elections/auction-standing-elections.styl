.auction-standing-elections
  padding 12px
  display flex
  flex-direction column
  gap 12px

  &__header
    display flex
    justify-content space-between
    align-items baseline
    gap 8px
    flex 1
    min-width 0
    font-size 11px
    color rgba(0, 0, 0, 0.6)

  &__title
    font-size 14px
    font-weight 700
    color $textColor

  &__group
    display flex
    flex-direction column
    gap 4px

    label
      font-size 11px
      text-transform uppercase
      opacity 0.6

  &__row
    display flex
    justify-content space-between
    align-items center
    gap 8px
    font-size 13px

  &__capped
    opacity 0.7
    font-style italic

  &__outcome
    font-size 11px
    text-transform uppercase
    opacity 0.7

  &__empty
    font-size 13px
    opacity 0.7

// Collapsible on a phone, where the root IS the Accordion and its summary
// button already owns the row's padding. Keeping the panel's own padding here
// would double it and push the chevron off the line.
.accordion.auction-standing-elections
  padding 0
  gap 0

  .auction-standing-elections__group
    padding-top 8px
