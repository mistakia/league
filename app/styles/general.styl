.scroll
  overflow-x hidden
  overflow-y auto !important
  -webkit-overflow-scrolling touch

.cursor
  cursor pointer

.league-container
  padding 16px 16px 0
  max-width 1200px
  margin 0 auto

  &.large
    max-width 1200px

  &.full
    max-width 100%

p
  margin-top 16px
  font-family "Inter", "Helvetica", "Arial", sans-serif
  font-weight 400
  line-height 1.5
  letter-spacing 0.00938em

// MUI puts dialogs, popovers, menus and autocomplete popups all on one layer
// (1300), and relies on DOM order to break the ties. That works until an app
// surface is raised above 1300 — the selected-player drawer sits at
// $z_selected_player — at which point the whole group falls behind it. These
// rules restate the group as an ordered set: a dialog above the drawer that
// opened it, and a dropdown above the dialog that contains it. Snackbar is here
// for the same reason, at its own rung — it hardcodes 1400, which ties the
// drawer and loses to any open dialog, and notifications fire from websocket
// events with no relation to what the user has open.
//
// Every selector is DOUBLED on purpose. MUI styles these components with an
// emotion class of its own, which is a single class like ours and is injected
// into head AFTER the app stylesheet — so a single-class rule here ties on
// specificity and loses on source order, silently and with no warning. That is
// not hypothetical: this whole block was written single-class first and changed
// nothing at all, while the drawer rule below kept working because it happens
// to be compound. Doubling takes each rule to (0,2,0) and wins outright.
// Removing a duplicate reverts the bug, so do not "tidy" them.
.MuiDialog-root.MuiDialog-root
  z-index $z_dialog

.MuiPopover-root.MuiPopover-root
.MuiMenu-root.MuiMenu-root
.MuiAutocomplete-popper.MuiAutocomplete-popper
  z-index $z_popper

.MuiSnackbar-root.MuiSnackbar-root
  z-index $z_snackbar

.MuiTooltip-popper.MuiTooltip-popper
  z-index $z_tooltip

.MuiTooltip-popper .MuiTooltip-tooltip
  color rgba(0, 0, 0, 0.87)
  font-size 11px
  box-shadow $box_shadow
  border 1px solid $borderColor
  background-color #fff

.MuiTooltip-popper.multiline .MuiTooltip-tooltip
  font-size 12px
  padding 12px 16px

// THE 16px FLOOR ON ANYTHING THAT TAKES TYPED TEXT, ON TOUCH DEVICES.
// iOS Safari zooms the viewport in whenever a text control whose COMPUTED
// font-size is under 16px takes focus, and there is no matching zoom back out
// on blur — the reader is left on a page scaled up and scrolled sideways, with
// pinch-out as the only way back. There is no API to reset the zoom level, so
// the only fix is to never give Safari the reason: 16px is the exact
// threshold, not a rounded-up guess.
//
// The other way out is `maximum-scale=1` on the viewport meta, and
// app/index.html explains at that tag why it is refused — it takes pinch zoom
// away from every reader to spare a few controls two pixels. It is also not
// even reliable; Safari has ignored it on user gesture since iOS 10.
//
// !important rather than the doubled-selector trick used above, because these
// are ELEMENT selectors at (0,0,1) and lose to every class in the app as well
// as to MUI's emotion classes. The floor has to hold against a component
// stylesheet that has not thought about the phone, which is the whole point:
// a control authored at 14px later stays harmless without a second edit.
//
// Only controls that raise a keyboard are listed. A native select opens a
// picker wheel and never zooms, and the excluded input types render as boxes
// and buttons whose size is set elsewhere.
@media (pointer: coarse)
  input:not([type='checkbox']):not([type='radio']):not([type='range']):not([type='color']):not([type='file']):not([type='button']):not([type='submit']):not([type='reset'])
  textarea
  [contenteditable]
    font-size 16px !important

.text-green
  color $green
  font-weight 600

.text-red
  color $red
  font-weight 600
