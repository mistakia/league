// THE PROSE-PAGE FORM LANGUAGE, shared by every page that talks to a person
// rather than showing him a table: the waiting-list questionnaire, the
// admission vote ballot, and the commissioner's side of that vote.
//
// These pages are read at a prose measure in the site's two fonts, and anything
// that looks like the app's dense chrome reads as a different site. They were
// each carrying their own copy of that language, which had already drifted
// three ways — two measures, two type scales, and a checkbox that was drawn on
// one page and invisible on another. This is the one definition.
//
// MIXINS AND VARIABLES ONLY, NO BARE RULES. This file is injected into every
// stylesheet in the app by webpack's stylusOptions.import, so a rule at the top
// level here would be emitted once per stylesheet. A mixin emits nothing until
// it is called.
//
// Injected AFTER variables.styl, so $textColor and its siblings resolve.

$prose_sans = 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif
$prose_mono = 'IBM Plex Mono', monospace

// THE PROSE INK PALETTE IS ITS OWN, and deliberately not the app's. The app is
// chrome around a table: mid-grey ink, which is right for a dense surface read
// in glances and wrong for one read in paragraphs. These pages share the app's
// GROUND (see prose_surface) and set their text in near-black ink on it, so the
// only things carrying colour are the one call to action and an error.
// $prose_paper is the palette's white and is what cards and controls take; it
// is not the page's background.
$prose_paper = #ffffff
$prose_ink = #17181a
$prose_body = #3d4045
$prose_muted = #6b7075
// THE HAIRLINE IS SET AGAINST THE GROUND, NOT AGAINST WHITE. These pages sit on
// $backgroundColor (#f0f0f0), and #e3e4e6 — the value this was — is four steps
// off it: the rules separating twelve directory entries were present in the DOM
// and invisible on screen, which is the one thing a page whose whole structure
// is rules cannot afford. This reads as a hairline on the grey ground and is
// still a hairline on the white of a card or a dialog.
$prose_rule = #d7d9dc
$prose_rule_strong = #c9cbcf
// The band rule. A hairline separates two things of the same kind; this one
// says a new SECTION begins, which is the distinction a page with no boxes has
// nothing else to make. Ink rather than a darker grey, because a grey heavy
// rule reads as a hairline someone thickened rather than as a different object.
$prose_rule_heavy = #17181a
// A deep red rather than the app's pure `red`, which is the one colour on the
// page and so the one that cannot afford to look like a default.
$prose_accent = #c1121f

// THE FILLED ACTION'S PAINT, which is deliberately NOT $prose_ink. Ink is a
// text colour: at near-black it is right for a letterform a few pixels wide
// and too heavy for a solid block several hundred pixels wide, which reads as
// a hole punched in the page rather than as a control sitting on it. This is a
// mid grey — light enough to read as a considered colour rather than as black,
// and still 5.47:1 against the white label it carries, which clears AA for the
// label at this size. That ratio is the floor on going lighter: #6b7075 is
// 5.0:1 and anything past it fails. One token so that every filled action
// moves together: the landing call to action, every prose submit, and the
// floating menu button.
$prose_action = #636a73

// 600 rather than 700 everywhere below: IBM Plex Mono and Inter are both loaded
// at 600, and 700 is not — asking for it gets a synthesized bold, which on mono
// in particular reads as a smudge. See the font comment in app/index.html.
$prose_bold = 600

// The surface. A prose page paints the WHOLE body rather than sitting as its
// own colour in a column, which would read as a card and put a hard edge down
// both sides of the measure. Call this on a wrapper around prose_page().
//
// ONE SURFACE ACROSS THE SITE. This is $backgroundColor — the same ground the
// app body, the menu drawer and the document pages carry — so no page differs
// from the chrome that frames it. The alternative was tried: paper here made
// the landing page the only surface on the site that did not match the menu
// beside it, which reads as the menu being wrong rather than as the page being
// paper. Paper is still the palette's own colour and is what the CARDS and
// CONTROLS on these pages take ($prose_paper below); it is the ground that is
// shared, not every element on it.
prose_surface()
  min-height 100%
  background $backgroundColor

// The measure. One across every prose page: these are read one after another by
// the same person, and a measure that changes between them reads as a different
// site rather than as a different page. 680px at 17px holds a line near 72
// characters — past that the eye loses the start of the next line, which is the
// failure these pages can least afford, since their whole job is being read.
prose_page()
  max-width 680px
  margin 0 auto
  padding 88px 32px 120px
  font 400 17px/1.7 $prose_sans
  color $prose_body
  -webkit-font-smoothing antialiased

  p
    margin 0 0 1em

  a
    color $prose_ink
    font-weight $prose_bold
    font-family $prose_mono
    border-bottom 1px solid $prose_rule_strong
    transition border-color 120ms ease, color 120ms ease
    &:hover
      color $prose_accent
      border-bottom-color $prose_accent
    &:focus-visible
      outline 2px solid $prose_accent
      outline-offset 3px

  @media (max-width 640px)
    padding 48px 22px 80px

// THE READING PAGES ARE WIDER THAN THE FORM PAGES, and they are the exception
// rather than a second opinion about the measure. 680px is a PROSE measure —
// one column of running text at ~72 characters — and the questionnaire and the
// ballot are exactly that, so they keep it. The front door and the pitch are
// not: their body is a rail, and inside 680px the rail leaves the prose column
// at 412px, which is a newspaper column's width being asked to carry ordinary
// sentences. The wider page spends every added pixel on that column and none on
// the rail, so the running text lands back at a real measure.
//
// The HERO does not widen with it — the lede stays at 26ch and the deck at 46ch
// — so the top of the page reads at the same measure it always did and only the
// worksheet below it grows.
prose_page_wide()
  prose_page()
  max-width 880px

// The line above a title: what this is, before what it says. Mono and tiny, so
// it reads as a label rather than as the first sentence of the page.
prose_eyebrow()
  margin 0 0 20px
  font-family $prose_mono
  font-weight 500
  font-size 0.75em
  letter-spacing 0.16em
  text-transform uppercase
  color $prose_muted

// The page's one large piece of type. Mono is the signature on these pages —
// the argument they make is that the league runs on software that is public —
// so the title is set in it rather than in the body face. Mono sets loose by
// construction, so it takes negative tracking and tight leading at this size or
// it reads as a terminal dump rather than as a headline.
prose_title()
  margin 0 0 0.6em
  font-family $prose_mono
  font-weight $prose_bold
  font-size clamp(30px, 4.4vw, 40px)
  line-height 1.15
  letter-spacing -0.02em
  color $prose_ink

// A section heading inside the page. Small, uppercase and spaced rather than
// large: the page has no rules or boxes, so weight and spacing are what
// separate one part from the next.
prose_section_title()
  margin 0 0 0.9em
  font-family $prose_mono
  font-weight $prose_bold
  font-size 0.8125em
  letter-spacing 0.14em
  text-transform uppercase
  color $prose_muted

// THE SECTION BAND. A reading page with no boxes has spacing and rules and
// nothing else, and spacing alone cannot say which of two gaps is the bigger
// break — 72px above a section and 24px above an entry are the same gesture at
// different amounts, so a reader scrolling past the fold loses where one group
// ended. The band rule is the newspaper answer: an ink rule spanning the
// measure, the label tight under it, and everything down to the next rule
// belongs to that label. Its weight is the whole point, so it takes
// $prose_rule_heavy and the entries inside it keep the hairline.
//
// The FIRST band on a page takes the heavy weight and doubles as the masthead
// rule. Giving the header its own rule as well puts two parallel rules sixty
// pixels apart with nothing between them, which reads as a mistake rather than
// as two levels of break — the header is separated from the page by the same
// rule that opens the first section.
prose_section_band(weight = 1px)
  padding-top 20px
  border-top weight solid $prose_rule_heavy

// THE LABEL RAIL — the worksheet half of the language, and the one structure
// these pages share. A directory entry and a group of league rules are the same
// object: a short mono label naming a thing, and prose about it. Stacked, that
// is twenty-odd left-aligned blocks the eye cannot tell apart; in a rail the
// labels form a column of their own that can be read down without reading any
// of the prose beside them.
//
// grid rather than flex, because the two cells have to share a baseline row and
// a flex row makes the label's height depend on the prose next to it.
//
// 208px is set against the LONGEST label rather than the average: mono at
// 0.9375em is about 9px a character, so the rail holds ~19 and the one
// twenty-seven-character entry on the landing page takes two lines, which is
// the right trade against a rail wide enough to strand every short label.
//
// It COLLAPSES rather than narrows at 640px. A rail that is a quarter of a
// phone screen leaves the prose at a measure too short to read, and the label
// above its own paragraph is what a worksheet does on a narrow page anyway.
// THE TWO CELLS SIT ON ONE BASELINE, which is the whole gesture a ruled
// worksheet makes and the one thing the rail was not doing. The label is set
// smaller than the prose beside it and in a different face, so aligning the two
// BOXES leaves their first baselines 3px apart on a landing entry, 7px on a
// Genesis group and 9px under a section head — three different amounts of not
// quite right, which reads as a row that never settled.
//
// `align-items baseline` rather than a padding on each label: the offset is a
// function of two fonts' metrics and three type sizes, so a hardcoded nudge is
// three magic numbers that are wrong the moment any of the five inputs moves.
// Grid baseline alignment is what this is for, and it costs one declaration.
//
// Inert below 640px, where the rail is `display block` and the label sits above
// its own paragraph rather than beside it.
prose_rail()
  display grid
  grid-template-columns 208px 1fr
  column-gap 28px
  align-items baseline

  @media (max-width 640px)
    display block

// THE SECTION LABEL — the standing head under a band rule, and deliberately the
// one label on these pages set in the SANS. Everything else at label scale is
// mono, so the face itself is what marks a section head as a different kind of
// object from the group labels and entry labels inside it; that is a distinction
// weight and colour were being asked to carry alone.
//
// 700, WHICH IS A REAL WEIGHT HERE. $prose_bold is 600 because IBM Plex Mono
// loads 300/400/500/600 and asking mono for 700 gets a synthesized smudge —
// that constraint is the MONO's, not the page's. Inter loads 400/500/600/700
// (see the font link in app/index.html), so a sans label at 700 is drawn rather
// than faked, and it is the only place on these pages that can go heavier.
//
// Smaller than the mono labels it sits above, because Inter at 700 sets far
// denser than Plex Mono at 600 — matching their point sizes would make the
// section head the loudest thing on the page, which inverts the order the band
// rule already establishes.
prose_section_label()
  margin 0
  font-family $prose_sans
  font-weight 700
  font-size 0.6875em
  letter-spacing 0.12em
  text-transform uppercase
  color $prose_ink

prose_form()
  display flex
  flex-direction column
  gap 36px
  margin-top 56px

// A field is a block: prompt, then the reason it is being asked, then the box.
// The gap carries the separation — a form that looks like paperwork gets
// abandoned, so there are no rules or boxes around a question.
prose_field()
  display flex
  flex-direction column
  gap 10px

prose_label()
  font-family $prose_mono
  font-weight $prose_bold
  font-size 0.9375em
  line-height 1.4
  letter-spacing -0.01em
  color $prose_ink

prose_help()
  font-size 0.9375em
  line-height 1.55
  color $prose_muted

// 17px is not a preference — a control under 16px makes iOS Safari zoom the
// page on focus, and it does not zoom back out.
prose_input()
  width 100%
  padding 13px 14px
  font 400 17px/1.5 $prose_sans
  color $prose_ink
  background $prose_paper
  border 1px solid $prose_rule_strong
  border-radius 3px
  box-sizing border-box
  transition border-color 120ms ease, box-shadow 120ms ease
  &::placeholder
    color $prose_muted
  &:hover
    border-color $prose_muted
  // The ring is the focus indicator rather than a colour swap alone: a border
  // that only changes hue is invisible to anyone who cannot separate the two.
  &:focus
    outline none
    border-color $prose_ink
    box-shadow 0 0 0 3px rgba(23, 24, 26, 0.08)

// THE NATIVE ARROW IS DROPPED AND REDRAWN. normalize.css strips appearance
// from `input` only, so a select keeps the platform control — and the platform
// control is a chunky OS-blue button jammed against the right border, drawn at
// a size and colour nothing else on the page shares. It is the one element that
// makes a typeset page look like a form built out of defaults.
//
// Unlike the checkbox below, dropping appearance here is safe: a select renders
// its own text, so removing the arrow costs the arrow and nothing else. The
// replacement is a chevron drawn in the page's ink, with padding on the right
// to reserve room for it — without that padding a long option collides with it.
//
// background-position and background-size are their own declarations rather
// than the `center / w h` half of the shorthand: stylus reads that slash as
// DIVISION once either side is an expression, and the parse error it raises is
// reported against every OTHER stylesheet in the app, since this file is
// injected into all of them.
prose_select()
  prose_input()
  cursor pointer
  appearance none
  -webkit-appearance none
  -moz-appearance none
  padding-right 44px
  background-image url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Cpath fill='none' stroke='%2317181a' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round' d='M4 6.5l4 4 4-4'/%3E%3C/svg%3E")
  background-repeat no-repeat
  background-position right 15px center
  background-size 13px 13px
  // Safari and Firefox both indent the text of an appearance-none select by a
  // few pixels of their own; zeroing it puts the value on the same left edge as
  // every text input above and below it.
  text-indent 0
  &::-ms-expand
    display none

// THE BOX IS DRAWN HERE BECAUSE THERE IS NO NATIVE ONE TO STYLE.
// app/styles/normalize.css carries a global `input { -webkit-appearance: none }`,
// which strips the platform checkbox app-wide — so a bare checkbox renders with
// no tick and no intrinsic size, and `accent-color` does nothing, since it only
// applies to natively-rendered controls. Every property below is load-bearing;
// this is not decoration over a working control.
//
// This mixin exists because that trap has already cost two features. The
// waiting-list page drew its own box and wrote the reason down; the commissioner
// page did not, and shipped a 0x0 control that toggled correctly and was
// invisible, which read as team selection being broken. Call this rather than
// styling a checkbox by hand.
prose_checkbox(size = 20px, tick = 13px)
  flex-shrink 0
  width size
  height size
  margin 0
  border 1px solid $prose_rule_strong
  border-radius 3px
  background $prose_paper
  cursor pointer
  transition background 120ms ease, border-color 120ms ease

  &:hover
    border-color $prose_ink

  // Checked state has to supply its own mark. The tick is an inline SVG
  // background rather than a pseudo-element: `input` is a void element, and
  // generated content on one is not reliable across browsers even once
  // appearance is stripped.
  //
  // background-size is its own declaration rather than the `center / w h` half
  // of the shorthand: stylus reads that slash as DIVISION once either side is
  // an expression rather than a literal, and the parse error it raises is
  // reported against every OTHER stylesheet in the app, since this file is
  // injected into all of them.
  &:checked
    background $prose_ink url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Cpath fill='none' stroke='%23fff' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round' d='M3.5 8.5l3 3 6-6'/%3E%3C/svg%3E") center no-repeat
    background-size tick tick
    border-color $prose_ink

  &:focus-visible
    outline 2px solid $prose_accent
    outline-offset 2px

// A checkbox with its label beside it, which is how every one of these pages
// uses it.
prose_checkbox_label()
  display flex
  align-items center
  gap 8px
  font-size 0.9375em
  cursor pointer

// THE FILLED ACTION, paint and type only, with no opinion about how it sits in
// its parent. Split out from prose_submit() because the landing page's call to
// action is an ANCHOR in a flex row rather than a submit button in a column: it
// wants every declaration below and none of the three that follow them, and it
// had been carrying its own copy of all thirteen. A form's submit and a page's
// call to action are the same object wearing different layout.
//
// `color` is restated on :hover because prose_page() gives every anchor an
// accent hover colour, which would otherwise repaint the label of a filled
// button against its accent background. On a `button` the line is inert.
prose_action_fill()
  padding 16px 30px
  font-family $prose_mono
  font-weight $prose_bold
  font-size 0.9375em
  letter-spacing 0.02em
  color $prose_paper
  background $prose_action
  border none
  border-radius 3px
  cursor pointer
  transition background 120ms ease, transform 120ms ease
  &:hover
    background $prose_accent
    color $prose_paper
  &:active
    transform translateY(1px)
  &:focus-visible
    outline 2px solid $prose_accent
    outline-offset 3px

// NO ANCHOR-AS-BUTTON MIXIN LIVES HERE, deliberately. Both reading pages —
// the landing page and the Genesis League pitch — carried a filled call to
// action and both dropped it: a filled button is the register of something
// being sold, and neither page sells anything. Their next steps are ordinary
// text links now. prose_action_fill() below is for real form SUBMITS, which
// is a different object; if a reading page ever wants a filled anchor again,
// note that it needs the inline-flex box and the underline removal that
// prose_page() otherwise forces on every link.

// THE FLOATING CONTROL, and the reason it is a mixin is that there are now two
// of them stacked in the same corner of the auction: the nav menu button and the
// commissioner controls above it. Two floating buttons a gap apart have to be
// the same object or the pair reads as two unrelated widgets that happened to
// land together, which is exactly what it read as while one was this paint and
// the other was MUI's SpeedDial.
//
// DELIBERATELY NOT prose_action_fill(), for the reason menu.styl gave before
// this moved: half of that mixin fits and half does not. A floating control
// carries its own geometry, a shadow and label-scale type, so calling it would
// emit four declarations every caller immediately overrides. This is the same
// paint named from the same variables rather than a shim over the mixin.
//
// THE REAL CONSTRAINT IS THAT IT FLOATS OVER EVERYTHING — tables, the auction,
// the players list and the prose pages, all on the same $backgroundColor
// surface. $prose_action is the one fill that works: light enough not to shout,
// dark enough that it never dissolves into the ground the way an outlined or
// white button does. The accent is the site's ONE accent and cannot be spent on
// a control that is on screen at all times, so it goes on HOVER — the same
// bargain prose_action_fill() makes for the landing call to action.
//
// The horizontal padding is ASYMMETRIC ON PURPOSE. The wide tracking below
// leaves a trailing space after the final letter, which sits a label left of the
// box's centre under equal padding. THE GAP STAYS 2px WHATEVER THE PADDING IS,
// because it answers the trailing space rather than the box: 0.16em at 11px is
// 1.76px, so 2px is the correction at any size. It is inert on a caller that
// centres its label in a stretched box, which is what the stacked commissioner
// actions do.
prose_floating_action()
  display inline-flex
  align-items center
  // 38px, and the label is the whole control — there is no glyph beside it. A
  // mark and a word both saying the same thing is that thing twice, and at label
  // scale the glyph is the larger of the two, so the word ends up arguing with
  // an icon that outweighs it.
  height $floating_action_height
  padding 0 14px 0 16px
  border none
  border-radius 3px
  background $prose_action
  color $prose_paper
  // The site's label voice — prose_eyebrow()'s mono at small size with wide
  // tracking — rather than MUI Button's sans at 14px. Uppercase survives because
  // it belongs to both languages; the face, the size and the tracking are what
  // separated them.
  font-family $prose_mono
  font-size 11px
  font-weight $prose_bold
  letter-spacing 0.16em
  text-transform uppercase
  white-space nowrap
  cursor pointer
  // ONE layer, not Material's three. The contrast against both surfaces is
  // already doing the separating, so the shadow only has to lift the object off
  // the page.
  box-shadow 0 6px 20px rgba(23, 24, 26, 0.18)
  transition background 120ms ease, box-shadow 120ms ease, transform 120ms ease
  &:hover
    background $prose_accent
    box-shadow 0 8px 24px rgba(193, 18, 31, 0.24)
  &:active
    transform translateY(1px)
  // Ink rather than the accent ring the drawer's own buttons get, because THIS
  // button repaints to the accent on hover — an accent ring on an accent fill is
  // no ring at all for anyone who tabs to a button the pointer is resting on.
  // The offset leaves a gap of surface showing, so the ring reads in every
  // state: against the graphite fill, against the accent one, and against the
  // page.
  &:focus-visible
    outline 2px solid $prose_ink
    outline-offset 3px

// The disabled state lives HERE and not in the fill above, because only a
// control that can be disabled can have one — an anchor cannot, so putting it
// in the shared paint emitted four lines of CSS the landing page's call to
// action could never match.
prose_submit()
  prose_action_fill()
  align-self flex-start
  &:disabled
    opacity 0.45
    cursor default
  // Full width on a phone: a left-aligned button at the end of a long form is
  // easy to miss, and a thumb reaches the middle of the screen, not its edge.
  @media (max-width 640px)
    align-self stretch
    text-align center

// The quieter of the two buttons — an action that is not the point of the page
// (adding another candidate row, closing a vote). Outlined rather than filled,
// so the filled one stays the thing the eye lands on.
prose_button_secondary()
  align-self flex-start
  padding 10px 18px
  font-family $prose_mono
  font-weight $prose_bold
  font-size 0.875em
  color $prose_ink
  background transparent
  border 1px solid $prose_rule_strong
  border-radius 3px
  cursor pointer
  transition border-color 120ms ease, color 120ms ease
  &:hover
    border-color $prose_ink
  &:focus-visible
    outline 2px solid $prose_accent
    outline-offset 2px
  &:disabled
    opacity 0.5
    cursor default

// A message the page is making, set off by a bar rather than a box. The accent
// bar is the error; the plain one is ordinary confirmation.
// The shared block typography, split out so the error does not have to UNDO a
// border it never wanted. A note and an error differ in what carries the
// signal, not in how the text is set.
prose_message_block()
  padding 12px 14px
  font-size 0.9375em

// A standing note. The rule is what marks it as set apart from the form, since
// its text is the same weight and colour as everything around it.
prose_message()
  prose_message_block()
  color $prose_ink
  border-left 3px solid $prose_rule_strong

// An error carries its signal in the COLOUR, so it needs no rule — a red rule
// beside red text states the same thing twice, and a form that is quiet
// everywhere else does not need two markers to be noticed.
prose_error()
  prose_message_block()
  padding-left 0
  color $prose_accent
