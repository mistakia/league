$textColor = #444
$textColorDark = darken($textColor, 4)

$backgroundColor = #f0f0f0
$accentColor = red

$borderColor = #d0d0d0
$borderColorLight = lighten($borderColor, 90)

$menuWidth = 240px
$auctionHeightDesktop = 164px
// THE WHOLE AUCTION CHROME, not just the bid bar: the bar plus the team strip
// beneath it. Four places derive from it and they must agree or the chrome and
// the page disagree about where one ends -- `.auction__controls` height, the
// `.page` bottom margin that reserves the space, the floating menu button's
// offset, and the commissioner controls'.
//
// 214 = the stacked bar's 120 plus the team strip's 94, and it is now a flat
// number rather than a maximum over widths because THE BAR NO LONGER WRAPS
// ANYWHERE. It was 240, which was 145 -- the bar at 600, where the election
// controls wrapped to two lines -- plus the strip. That wrap turned out to be a
// leaked stylesheet rule rather than a width problem: the `max-width 700px`
// block in auction-election-control.styl is written for the drawer form and its
// selectors were unqualified, so it also reached the compact strip in the bar
// and doubled it from 26px to 54px. Scoped off compact, the bar measures 120px
// at every width from 1159 down to 320 and the chrome measures 214 at all of
// them.
//
// It still has to be the MAXIMUM over the widths rather than the height at any
// one of them, because the reservation is a static number while the thing it
// reserves for is not: `.auction__controls` sits in the band this margin opens,
// so anything it needs beyond this comes out of its own last child rather than
// out of the page. That is what the old 215 got wrong -- the strip is that last
// child, and the overflow surfaced as the `Nominating` label clipped off the
// chips rather than as a layout that had run out of room. The maximum happens to
// equal the height everywhere right now; if a width is ever found where the bar
// wraps again, this has to go up to meet it.
//
// DO NOT TUNE THIS BY WATCHING THE CLIP SHRINK. The strip REFLOWS under
// pressure -- squeezed it reports 79, then 84, then 87 as it is given room, so
// each increment closes less of the gap than it should and the sequence reads
// as converging on a value below the real one. Measured with room to spare it
// wants 94 flat at every narrow width, and that is the number to add the bar to.
$auctionHeightMobile = 214px

$successColor = green
$yellowColor = #ff0

$box_shadow = $borderColor 4px 4px 0px 0px
$smooth_transition = 250ms cubic-bezier(0.4, 0, 0.2, 1) 0ms

// Layering scale. Anything that floats above page content takes its z-index
// from here — never a bare literal, and never a value nudged upward to win a
// specific collision. The app hand-rolls its nav drawer and several poppers, so
// MUI's own defaults (drawer 1200, modal 1300, tooltip 1500) are not sufficient
// on their own: raising one surface above a neighbour silently pushes it above
// every MUI layer that sat between them.
// The order is the whole point, so read it as a sequence rather than as
// values. A surface that is always opened FROM another surface — a dropdown, a
// menu, a tooltip — belongs ABOVE everything that can open it, which is why
// poppers sit above dialogs rather than beside them: ten confirmation dialogs
// here contain a Select or an Autocomplete.
$z_page_chrome = 1000            // sticky table headers, fixed in-page notices
$z_floating_action = 1100        // floating action buttons
$z_overlay_backdrop = 1200       // scrim behind a hand-rolled overlay panel
$z_overlay_panel = 1300          // nav drawer, speed dial — MUI's drawer layer
$z_selected_player = 1400        // selected-player drawer, above the nav drawer
$z_react_table_base = 1450       // react-table's own six-rung band, 1451-1456
$z_dialog = 1500                 // MUI dialogs and confirmations
$z_snackbar = 1550               // async notifications, above any open dialog
$z_popper = 1600                 // dropdowns, selects, autocompletes, menus
$z_context_menu_backdrop = 1650
$z_context_menu = 1700           // right-click menu, above whatever opened it
$z_tooltip = 1800
$z_app_backdrop = 1900           // app-initializing scrim, blocks everything
$z_banner = 2000                 // app-wide notice banner, above every surface

// Button styles
$button_border_radius = 4px

// THE CONTROL HEIGHT, shared by every button and text input that sits on a row
// with one. A button and the input beside it lining up is not a coincidence to
// be re-tuned per surface — it is one number, and two surfaces that each pick
// their own drift the moment either changes its padding or its font size.
// Every control taking this must also set `box-sizing: border-box`, or a border
// makes the outer box 2px taller than the number says.
$control_height = 36px

// THE WIDTH OF A SHORT FORM FIELD, and the companion to $control_height above:
// one number for the axis a text input is measured on, so a username box and
// the box under it cannot end up 40px apart for no reason. Sized to the CONTENT
// rather than to the container — a username caps at 20 characters and an email
// rarely runs past 40, and a field stretched to a 1200px container announces a
// capacity it does not have.
$field_width = 320px

// The resting fill of a control that is not the point of its surface. Light
// enough to sit under body text without competing, dark enough to read as a
// control against both the app's white cards and its $backgroundColor ground.
$control_fill = #e9e9ec

$hover_background = rgba(255, 255, 255, 0.8)

// THE HOVER LIFT, shared. `.menu__section:hover` is where this started and it
// is still the only other caller; it is here rather than in menu.styl so a
// second surface cannot arrive at a near-miss copy of it.
//
// $box_shadow is a HARD offset — `$borderColor 4px 4px 0 0`, no blur radius —
// which is why it belongs on a flat surface at all. A blurred shadow simulates
// a light source and puts the object on a fake z-axis; an unblurred offset
// block is a graphic device, closer to a printed drop shadow than to Material's
// elevation, and it reads as emphasis rather than as height.
//
// The caller keeps its own border-color change if it wants one. This is the
// lift, not a whole hover state, and the menu's near-black border edge is the
// menu's business.
hover_lift()
  background $hover_background
  box-shadow $box_shadow

// OVERRIDING A .button DECLARATION FROM A COMPONENT STYLESHEET.
//
// button.styl's base rule is guarded by a four-:not() chain that keeps it off
// MUI's own buttons — react-table still ships them — which puts it at 0,5,0,
// and its nested .button__small and .button__icon blocks a step higher again.
// A component rule written at its natural specificity therefore LOSES SILENTLY:
// it emits, it is right there in the stylesheet, and it never applies.
//
// That is not hypothetical. Six rules went dead exactly this way when the app's
// buttons moved off MUI — each had been live, and each dropped its styling with
// no error, no build failure and nothing to grep for, since the CSS is present.
// Same family as the unimported-mixin and undefined-variable traps this file's
// neighbours record: the failure is silence.
//
// Call it as a block mixin:
//
//   .my-thing .button__icon
//     +button_override()
//       padding 0 4px
//
// It repeats the guard chain AND the .button class, so the result clears both
// the base rule and its small/icon variants whatever the chunk order turns out
// to be. Only reach for it on a property button.styl actually sets — a property
// it does not set (min-height, white-space, margin) applies without this.
button_override()
  &.button:not(.MuiButton-root):not(.MuiIconButton-root):not(.MuiFab-root):not(.MuiButtonBase-root)
    {block}

$qb_color = tint(red, 25%)
$wr_color = tint(orange, 25%)
$rb_color = tint(green, 25%)
$te_color = tint(blue, 25%)
$k_color = tint(grey, 25%)
$dst_color = tint(black, 25%)

// CSS custom properties — same values as the Stylus variables above so JS can
// read them at runtime via getComputedStyle without duplicating hex literals.
// tint(red,25%)=#ff4040 tint(orange,25%)=#ffbc40 tint(green,25%)=#40a040
// tint(blue,25%)=#4040ff tint(grey,25%)=#a0a0a0 tint(black,25%)=#404040
:root
  // react-table derives its whole layer band from this one value, so setting it
  // slots the table's menus, overlays, modal and poppers into the scale above
  // rather than leaving them on the lib's default 1001-1006 (which sits below
  // everything here). The band lands between $z_selected_player and $z_dialog:
  // the table's view modal is covered by our confirmations, and covers the
  // selected-player drawer. It MUST be set here at :root — react-table builds
  // its rungs with calc(), which substitutes where the token is declared, so an
  // override on any descendant silently does nothing. See react-table STYLE.md.
  --rt-z-base $z_react_table_base

  // No --app-banner-height default here on purpose: league-pause-notice is the
  // only writer of that property (it publishes a measured `<n>px` on <html>
  // and removes it on unmount), and every consumer carries its own `0px`
  // fallback. A `0px` declared here would ship as a UNITLESS 0 in the
  // production bundle: stylus-loader defaults compress on for production-like
  // builds (mode "production" OR no mode — `yarn build` sets neither) and the
  // compressor normalizes a zero length, so the served :root read
  // `--app-banner-height: 0` while the dev build (mode development, compress
  // off) kept the 0px and the drawer only broke once deployed. Substituted
  // into the selected-player calc that makes the whole height declaration
  // invalid, and the var(...) fallback never fires because 0 is a SET value.
  // A JS-owned var is not a build-time token — see write-stylus.md.

  --pos-QB #ff4040
  --pos-WR #ffbc40
  --pos-RB #40a040
  --pos-TE #4040ff
  --pos-K #a0a0a0
  --pos-DST #404040

// Position styling mixin for consistent position-based backgrounds and text colors
position-background-mixin()
  &.QB
    background $qb_color
    .draft-pick-item-player-last, .draft-pick-item-player-first, .draft__pick-num, .draft__pick-player-name
      color white
      
  &.WR
    background $wr_color
    
  &.RB
    background $rb_color
    .draft-pick-item-player-last, .draft-pick-item-player-first, .draft__pick-num, .draft__pick-player-name
      color white
      
  &.TE
    background $te_color
    .draft-pick-item-player-last, .draft-pick-item-player-first, .draft__pick-num, .draft__pick-player-name
      color white
      
  &.K
    background $k_color
    
  &.DST
    background $dst_color
    .draft-pick-item-player-last, .draft-pick-item-player-first, .draft__pick-num, .draft__pick-player-name
      color white

// Text truncation mixin for consistent text overflow handling
text-truncate()
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

